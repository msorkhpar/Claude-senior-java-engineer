    "aspects": [
      {
        "id": "atomic-reference-lazy",
        "says": "A lazy proxy built on AtomicReference.compareAndSet is lock-free but may create the real subject more than once, keeping only one.",
        "basis": [
          "section:Interview Q&A Section",
          "example:37-structural-patterns/README_9.2.3.md:11",
          "example:37-structural-patterns/README_9.2.3.md:12"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "caching-proxy",
        "says": "A caching proxy stores each result and answers repeated calls from the cache, with ConcurrentHashMap.computeIfAbsent keeping it thread-safe, and clearCache for staleness.",
        "basis": [
          "section:Best Practices and Optimization Techniques",
          "example:37-structural-patterns/README_9.2.3.md:14"
        ],
        "exercise": "caching-proxy",
        "reason": null
      },
      {
        "id": "dynamic-proxy",
        "says": "java.lang.reflect.Proxy creates at run time a proxy for interfaces that sends every call to one InvocationHandler.",
        "basis": [
          "section:Interview Q&A Section",
          "example:37-structural-patterns/README_9.2.3.md:7",
          "example:37-structural-patterns/README_9.2.3.md:8"
        ],
        "exercise": "dynamic-logging-proxy",
        "reason": null
      },
      {
        "id": "god-proxy",
        "says": "A proxy that piles up caching, logging, access control and lazy loading breaks single responsibility, and proxy chains add call depth.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them"
        ],
        "exercise": null,
        "reason": "incidental detail, not practised; each practice builds a proxy with one concern"
      },
      {
        "id": "interfaces-only",
        "says": "JDK dynamic proxies work only for interfaces; classes need CGLIB or ByteBuddy.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them"
        ],
        "exercise": null,
        "reason": "Proxy.newProxyInstance itself refuses a class with IllegalArgumentException, so there is nothing for the reader to get wrong, and the libraries for classes are not on the classpath"
      },
      {
        "id": "java21-features",
        "says": "Sealed subject interfaces, records, switch pattern matching and virtual threads can shape proxies in Java 21.",
        "basis": [
          "section:Relevant Java 21 Features"
        ],
        "exercise": null,
        "reason": "incidental detail, not practised; sealed types, records and virtual threads have their own modules"
      },
      {
        "id": "logging-proxy-log",
        "says": "A logging proxy records each call and returns its audit log as an unmodifiable list.",
        "basis": [
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": null,
        "reason": "the read-only log is practised on the Decorator page (logging-decorator); the logging here is practised through the dynamic proxy"
      },
      {
        "id": "object-methods-null-args",
        "says": "The handler also receives toString, equals and hashCode, and gets a null argument array for methods without parameters.",
        "basis": [
          "section:Edge Cases and Their Handling",
          "section:Interview-specific Insights"
        ],
        "exercise": "dynamic-logging-proxy",
        "reason": null
      },
      {
        "id": "propagate-not-found",
        "says": "A protection proxy lets the real subject's NoSuchElementException propagate rather than hiding it.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "protection-proxy",
        "reason": null
      },
      {
        "id": "protection-proxy",
        "says": "A protection proxy checks the caller's role before delegating and refuses a call without ever reaching the real subject.",
        "basis": [
          "section:Interview Q&A Section",
          "example:37-structural-patterns/README_9.2.3.md:3"
        ],
        "exercise": "protection-proxy",
        "reason": null
      },
      {
        "id": "proxy-vs-decorator",
        "says": "A proxy controls access and often manages the real subject's lifecycle, where a decorator adds behaviour to a component it receives and always delegates.",
        "basis": [
          "section:Interview Q&A Section",
          "example:37-structural-patterns/README_9.2.3.md:5",
          "example:37-structural-patterns/README_9.2.3.md:6"
        ],
        "exercise": null,
        "reason": "the page itself says the line blurs; the practices show the proxy side in code, a virtual proxy that creates its subject and a protection proxy that refuses to delegate"
      },
      {
        "id": "remote-proxy",
        "says": "A remote proxy stands for an object in another address space, such as an RMI stub.",
        "basis": [
          "section:Concept Explanation"
        ],
        "exercise": null,
        "reason": "a remote proxy needs a network or a second JVM, which a practice cannot use"
      },
      {
        "id": "same-interface",
        "says": "A proxy implements the same interface as the real subject, so the client cannot tell the two apart.",
        "basis": [
          "section:Concept Explanation",
          "section:Key Points to Remember"
        ],
        "exercise": "virtual-image-proxy",
        "reason": null
      },
      {
        "id": "self-invocation",
        "says": "A call a bean makes on itself through this bypasses its proxy, so the proxy's behaviour does not apply to it.",
        "basis": [
          "section:Interview Q&A Section",
          "example:37-structural-patterns/README_9.2.3.md:10"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "spring-transactional",
        "says": "Spring's @Transactional wraps a bean in a proxy that begins a transaction, commits after the method, and rolls back on an exception.",
        "basis": [
          "section:Interview Q&A Section",
          "example:37-structural-patterns/README_9.2.3.md:9",
          "example:37-structural-patterns/README_9.2.3.md:10"
        ],
        "exercise": "transactional-proxy",
        "reason": null
      },
      {
        "id": "thread-safe-lazy",
        "says": "A virtual proxy shared between threads must make its lazy creation thread-safe, for example with double-checked locking on a volatile field.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "example:37-structural-patterns/README_9.2.3.md:2",
          "example:37-structural-patterns/README_9.2.3.md:12"
        ],
        "exercise": "virtual-image-proxy",
        "reason": null
      },
      {
        "id": "unwrap-ite",
        "says": "An InvocationHandler unwraps the InvocationTargetException from Method.invoke and rethrows its cause, or the caller gets an UndeclaredThrowableException.",
        "basis": [
          "section:Interview Q&A Section",
          "example:37-structural-patterns/README_9.2.3.md:7"
        ],
        "exercise": "dynamic-logging-proxy",
        "reason": null
      },
      {
        "id": "virtual-proxy",
        "says": "A virtual proxy creates the expensive real subject only on first real use, answers what it already knows itself, and reuses the subject afterwards.",
        "basis": [
          "section:Interview Q&A Section",
          "example:37-structural-patterns/README_9.2.3.md:4",
          "example:37-structural-patterns/README_9.2.3.md:6"
        ],
        "exercise": "virtual-image-proxy",
        "reason": null
      },
      {
        "id": "when-to-proxy",
        "says": "A single lazy field is enough for an internal concern; a proxy pays off when control logic must stay hidden from clients or is shared by many.",
        "basis": [
          "section:Interview Q&A Section",
          "example:37-structural-patterns/README_9.2.3.md:13",
          "example:37-structural-patterns/README_9.2.3.md:14"
