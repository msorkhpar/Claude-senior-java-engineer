    "aspects": [
      {
        "id": "adapter-decorator-facade",
        "says": "An adapter changes an interface, a decorator keeps the interface and adds behaviour, and a facade simplifies a subsystem of many objects.",
        "basis": [
          "section:Interview Q&A Section",
          "example:37-structural-patterns/README_9.2.1.md:7",
          "example:37-structural-patterns/README_9.2.1.md:8"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "argument-conversion",
        "says": "An adapter converts arguments and results between the two interfaces, such as dollars to rounded cents and a status code to a result object.",
        "basis": [
          "section:Interview Q&A Section",
          "example:37-structural-patterns/README_9.2.1.md:4"
        ],
        "exercise": "payment-adapter",
        "reason": null
      },
      {
        "id": "class-adapter",
        "says": "A class adapter extends the adaptee and implements the target, calling the methods it inherits, so single inheritance limits it to one adaptee class.",
        "basis": [
          "section:Interview Q&A Section",
          "example:37-structural-patterns/README_9.2.1.md:5",
          "example:37-structural-patterns/README_9.2.1.md:6"
        ],
        "exercise": "object-and-class-adapter",
        "reason": null
      },
      {
        "id": "data-format-edges",
        "says": "A data-format adapter handles extra fields, too few fields and empty collections without failing in unexpected ways.",
        "basis": [
          "section:Edge Cases and Their Handling",
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": "user-data-adapter",
        "reason": null
      },
      {
        "id": "java21-features",
        "says": "Sealed target interfaces, records, pattern matching and default methods can shape adapters in Java 21.",
        "basis": [
          "section:Relevant Java 21 Features"
        ],
        "exercise": null,
        "reason": "incidental detail, not practised; sealed types and records have their own modules"
      },
      {
        "id": "jdk-adapters",
        "says": "The JDK has adapters of its own, such as Arrays.asList as a view of an array and Collections.enumeration and Collections.list between collections and Enumeration.",
        "basis": [
          "section:Interview Q&A Section",
          "example:37-structural-patterns/README_9.2.1.md:9",
          "example:37-structural-patterns/README_9.2.1.md:10"
        ],
        "exercise": "enumeration-adapter",
        "reason": null
      },
      {
        "id": "lambda-adapter",
        "says": "When the target is a functional interface, a lambda or method reference can be the whole adapter, translating parameters and results.",
        "basis": [
          "section:Interview Q&A Section",
          "example:37-structural-patterns/README_9.2.1.md:11",
          "example:37-structural-patterns/README_9.2.1.md:12"
        ],
        "exercise": "lambda-comparator-adapter",
        "reason": null
      },
      {
        "id": "lsp-partial",
        "says": "An adapter that throws UnsupportedOperationException for target methods the adaptee cannot support breaks the Liskov Substitution Principle; defaults are the page's remedy.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them"
        ],
        "exercise": null,
        "reason": "the page gives it as a design rule with no example of what a sensible default returns, so a test would have to invent the contract it checks"
      },
      {
        "id": "null-adaptee",
        "says": "An adapter validates its adaptee eagerly with Objects.requireNonNull, so a null fails at construction rather than on a later call.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "example:37-structural-patterns/README_9.2.1.md:2"
        ],
        "exercise": "object-and-class-adapter",
        "reason": null
      },
      {
        "id": "object-adapter",
        "says": "An object adapter implements the target interface and delegates to the adaptee it holds, so it works with any subclass of that adaptee.",
        "basis": [
          "section:Concept Explanation",
          "example:37-structural-patterns/README_9.2.1.md:1",
          "example:37-structural-patterns/README_9.2.1.md:6"
        ],
        "exercise": "object-and-class-adapter",
        "reason": null
      },
      {
        "id": "thread-safety",
        "says": "An adapter over a non-thread-safe adaptee documents that or adds synchronization.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": null,
        "reason": "incidental detail, not practised; locking itself is practised in the concurrency modules"
      },
      {
        "id": "translate-only",
        "says": "An adapter only translates the interface and adds no behaviour, so calls and the adaptee's exceptions pass through unchanged.",
        "basis": [
          "section:Key Points to Remember",
          "example:37-structural-patterns/README_9.2.1.md:3"
        ],
        "exercise": "object-and-class-adapter",
        "reason": null
      },
      {
        "id": "two-way-adapter",
        "says": "A two-way adapter lets each of two interfaces be used where the other is expected.",
        "basis": [
          "section:Key Points to Remember"
        ],
        "exercise": "enumeration-adapter",
        "reason": null
      },
      {
        "id": "when-not-to-adapt",
        "says": "When you control both interfaces you align them instead of adding an adapter, which is for code you cannot change.",
        "basis": [
          "section:Interview Q&A Section",
          "example:37-structural-patterns/README_9.2.1.md:13",
          "example:37-structural-patterns/README_9.2.1.md:14"
        ],
        "exercise": "quiz",
        "reason": null
      }
