    "aspects": [
      {
        "id": "base-decorator",
        "says": "An abstract base decorator holds the wrapped component and passes every method on, so concrete decorators override only what they change.",
        "basis": [
          "section:Best Practices and Optimization Techniques",
          "example:37-structural-patterns/README_9.2.2.md:15"
        ],
        "exercise": "notifier-chain",
        "reason": null
      },
      {
        "id": "decorator-vs-others",
        "says": "A decorator always delegates to the next layer, where a Chain of Responsibility handler may stop the request and a Strategy is one algorithm chosen among several.",
        "basis": [
          "section:Interview Q&A Section",
          "example:37-structural-patterns/README_9.2.2.md:8",
          "example:37-structural-patterns/README_9.2.2.md:9"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "disadvantages",
        "says": "Deep decorator chains are hard to debug, cannot remove a layer, and need every interface method forwarded.",
        "basis": [
          "section:Interview Q&A Section",
          "example:37-structural-patterns/README_9.2.2.md:14"
        ],
        "exercise": null,
        "reason": "the forwarding cost is practised through the base decorator in notifier-chain; the rest are judgement calls with no behaviour to check"
      },
      {
        "id": "identity",
        "says": "A decorated object is a different instance from the one it wraps, so identity checks with == between them fail.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "example:37-structural-patterns/README_9.2.2.md:2"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "java-io",
        "says": "java.io is built on the Decorator pattern: FilterInputStream is the base decorator and buffering, decompression and data reading are stacked around a concrete stream.",
        "basis": [
          "section:Interview Q&A Section",
          "example:37-structural-patterns/README_9.2.2.md:6",
          "example:37-structural-patterns/README_9.2.2.md:7"
        ],
        "exercise": "counting-stream",
        "reason": null
      },
      {
        "id": "java21-features",
        "says": "Sealed component interfaces, records, pattern matching and default methods can shape decorators in Java 21.",
        "basis": [
          "section:Relevant Java 21 Features"
        ],
        "exercise": null,
        "reason": "incidental detail, not practised; sealed types and records have their own modules"
      },
      {
        "id": "lambda-decorators",
        "says": "For a functional interface, Function.andThen and compose build decorators without wrapper classes.",
        "basis": [
          "section:Interview Q&A Section",
          "example:37-structural-patterns/README_9.2.2.md:10",
          "example:37-structural-patterns/README_9.2.2.md:11"
        ],
        "exercise": "function-decorators",
        "reason": null
      },
      {
        "id": "logging-decorator",
        "says": "A logging decorator records before and after it delegates, and exposes its log only as an unmodifiable view.",
        "basis": [
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": "logging-decorator",
        "reason": null
      },
      {
        "id": "null-wrappee",
        "says": "A decorator's constructor refuses a null wrapped component.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "example:37-structural-patterns/README_9.2.2.md:3"
        ],
        "exercise": "notifier-chain",
        "reason": null
      },
      {
        "id": "order-matters",
        "says": "The order of decorators changes the result: the outermost runs first on the way in, so compress-then-encrypt stores different data from encrypt-then-compress.",
        "basis": [
          "section:Interview Q&A Section",
          "example:37-structural-patterns/README_9.2.2.md:12",
          "example:37-structural-patterns/README_9.2.2.md:13"
        ],
        "exercise": "data-source-layers",
        "reason": null
      },
      {
        "id": "same-interface-delegate",
        "says": "A decorator implements the same interface as the component it wraps, delegates every operation to it and adds its own behaviour before or after.",
        "basis": [
          "section:Concept Explanation",
          "example:37-structural-patterns/README_9.2.2.md:1"
        ],
        "exercise": "notifier-chain",
        "reason": null
      },
      {
        "id": "serialization",
        "says": "Decorator chains are hard to serialize, so they are flattened or rebuilt on deserialization.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": null,
        "reason": "incidental detail, not practised; serialization has its own module"
      },
      {
        "id": "stacking",
        "says": "Decorators stack in any combination at run time, and applying the same decorator twice has a cumulative effect.",
        "basis": [
          "section:Edge Cases and Their Handling",
          "example:37-structural-patterns/README_9.2.2.md:5"
        ],
        "exercise": "notifier-chain",
        "reason": null
      },
      {
        "id": "subclass-explosion",
        "says": "Covering every combination of behaviours by subclassing needs a class per combination, where decorators need one class per behaviour.",
        "basis": [
          "section:Interview Q&A Section",
          "example:37-structural-patterns/README_9.2.2.md:4",
          "example:37-structural-patterns/README_9.2.2.md:5"
        ],
        "exercise": null,
        "reason": "a design argument with nothing to run; the notifier-chain practice has the reader build every combination from two decorator classes"
      },
      {
        "id": "thread-safety",
        "says": "A decorator that keeps state, such as a log, needs synchronization or a concurrent structure when shared between threads.",
        "basis": [
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": null,
        "reason": "incidental detail, not practised; thread-safe collections are practised in the concurrency modules"
      }
    ],
