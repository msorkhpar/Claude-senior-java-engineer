    "aspects": [
      {
        "id": "abstract-factory",
        "says": "Abstract Factory creates a family of related products through a factory object passed to clients, where Factory Method creates one product through a subclass override.",
        "basis": [
          "section:Interview Q&A Section",
          "example:36-creational-patterns/README_9.1.2.md:13",
          "example:36-creational-patterns/README_9.1.2.md:14"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "abstract-return-type",
        "says": "A factory method declares the abstract product as its return type, not a concrete class.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "example:36-creational-patterns/README_9.1.2.md:3"
        ],
        "exercise": null,
        "reason": "a declaration choice the compiler accepts either way, with no behaviour a test can observe"
      },
      {
        "id": "cached-instances",
        "says": "A factory method may return cached instances, as Integer.valueOf does, when the products are immutable.",
        "basis": [
          "section:Key Points to Remember",
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": "cached-factory",
        "reason": null
      },
      {
        "id": "generic-create",
        "says": "A generic factory method such as create(Class<T>) gives the caller a typed product without a cast.",
        "basis": [
          "section:Best Practices and Optimization Techniques",
          "example:36-creational-patterns/README_9.1.2.md:4"
        ],
        "exercise": "supplier-registry",
        "reason": null
      },
      {
        "id": "jdk-iterator",
        "says": "Collection.iterator() is a JDK factory method: each collection returns its own Iterator, a new one per call, and clients see only the interface.",
        "basis": [
          "section:Interview Q&A Section",
          "example:36-creational-patterns/README_9.1.2.md:9",
          "example:36-creational-patterns/README_9.1.2.md:10"
        ],
        "exercise": "iterator-factory",
        "reason": null
      },
      {
        "id": "lambda-factories",
        "says": "A Supplier registered under a name can replace a creator subclass, avoiding a parallel hierarchy of creators.",
        "basis": [
          "section:Best Practices and Optimization Techniques",
          "example:36-creational-patterns/README_9.1.2.md:16"
        ],
        "exercise": "supplier-registry",
        "reason": null
      },
      {
        "id": "no-null-product",
        "says": "A factory that returns null is a design error, so the null is caught with an exception rather than passed on.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "notification-factory",
        "reason": null
      },
      {
        "id": "open-closed",
        "says": "A new product type is added with a new product and a new creator subclass, without changing the creator, where a type conditional would have to be edited.",
        "basis": [
          "section:The Problem It Solves",
          "example:36-creational-patterns/README_9.1.2.md:1",
          "example:36-creational-patterns/README_9.1.2.md:7"
        ],
        "exercise": "notification-factory",
        "reason": null
      },
      {
        "id": "sealed-records",
        "says": "Products can be records under a sealed interface, and a switch over them with patterns needs no default.",
        "basis": [
          "section:Relevant Java 21 Features",
          "example:36-creational-patterns/README_9.1.2.md:12"
        ],
        "exercise": "shape-factory",
        "reason": null
      },
      {
        "id": "simple-factory",
        "says": "A Simple Factory is one static method that picks the product from a parameter, and an unknown type gets a descriptive exception, never a default product.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "example:36-creational-patterns/README_9.1.2.md:2",
          "example:36-creational-patterns/README_9.1.2.md:6"
        ],
        "exercise": "shape-factory",
        "reason": null
      },
      {
        "id": "simple-vs-method",
        "says": "A static method choosing the class is a Simple Factory; the Factory Method pattern delegates instantiation to subclasses.",
        "basis": [
          "section:Key Points to Remember",
          "example:36-creational-patterns/README_9.1.2.md:5"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "stateful-factory-threads",
        "says": "A factory that keeps state, such as a counter or cache, must be thread-safe.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": null,
        "reason": "a data race is not reproducible deterministically; the cached factory keeps its state in a concurrent map without grading races"
      },
      {
        "id": "subclass-decides",
        "says": "In the Factory Method pattern the creator's own logic calls an abstract factory method, and each subclass overrides it to decide the concrete product.",
        "basis": [
          "section:Concept Explanation",
          "section:Structure",
          "example:36-creational-patterns/README_9.1.2.md:8"
        ],
        "exercise": "notification-factory",
        "reason": null
      },
      {
        "id": "when-not",
        "says": "One product type with no expected variation is created with a constructor or a Supplier, not a factory hierarchy.",
        "basis": [
          "section:Interview Q&A Section",
          "example:36-creational-patterns/README_9.1.2.md:15"
        ],
        "exercise": null,
        "reason": "a design judgement with no observable result: both forms create the same object"
      }
    ],
