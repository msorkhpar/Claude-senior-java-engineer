  "plan": {
    "plan_api": 2,
    "tier": "core",
    "count": 6,
    "aspects": [
      {
        "id": "clone-guard",
        "says": "A Singleton that inherits a public clone() overrides it to throw CloneNotSupportedException.",
        "basis": [
          "section:Interview Q&A Section",
          "example:36-creational-patterns/README_9.1.1.md:13"
        ],
        "exercise": "secure-singleton",
        "reason": null
      },
      {
        "id": "enum-reflection",
        "says": "The JVM refuses to create an enum constant reflectively, so Constructor.newInstance on an enum throws IllegalArgumentException.",
        "basis": [
          "section:Interview Q&A Section",
          "example:36-creational-patterns/README_9.1.1.md:8"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "enum-singleton",
        "says": "An enum with one constant is a Singleton the JVM makes thread-safe, serialization-safe and reflection-safe, and its state is still the programmer's to protect.",
        "basis": [
          "section:Best Practices and Optimization Techniques",
          "example:36-creational-patterns/README_9.1.1.md:9"
        ],
        "exercise": "enum-pool",
        "reason": null
      },
      {
        "id": "hidden-dependency",
        "says": "A dependency passed through the constructor keeps each object testable, where getInstance() calls or static state are hidden global dependencies.",
        "basis": [
          "section:Best Practices and Optimization Techniques",
          "example:36-creational-patterns/README_9.1.1.md:15"
        ],
        "exercise": "injected-service",
        "reason": null
      },
      {
        "id": "holder-idiom",
        "says": "The Holder idiom creates the instance only when getInstance first reads the nested holder class, because class initialization is lazy and thread-safe.",
        "basis": [
          "section:Interview Q&A Section",
          "example:36-creational-patterns/README_9.1.1.md:11"
        ],
        "exercise": "holder-registry",
        "reason": null
      },
      {
        "id": "java21-features",
        "says": "Sealed interfaces, records and virtual threads can accompany a Singleton, though a record cannot hide its constructor and sealing cannot forbid subclassing.",
        "basis": [
          "section:Relevant Java 21 Features"
        ],
        "exercise": null,
        "reason": "incidental detail, not practised; sealed types and records have their own modules (10 and 09)"
      },
      {
        "id": "lazy-thread-safe",
        "says": "A lazy Singleton creates its instance on first use, and concurrent first calls must still create only one, which double-checked locking does by checking again inside the lock.",
        "basis": [
          "section:Edge Cases and Their Handling",
          "example:36-creational-patterns/README_9.1.1.md:7"
        ],
        "exercise": "lazy-once",
        "reason": null
      },
      {
        "id": "one-instance",
        "says": "A Singleton has a private constructor, a static field holding its one instance and a static method that returns it.",
        "basis": [
          "section:How It Works",
          "example:36-creational-patterns/README_9.1.1.md:5"
        ],
        "exercise": "holder-registry",
        "reason": null
      },
      {
        "id": "per-classloader",
        "says": "A Singleton is one instance per class loader, so two class loaders that load the class each hold their own.",
        "basis": [
          "section:Key Points to Remember"
        ],
        "exercise": null,
        "reason": "the page's remedy is a deployment choice (a common parent loader or a DI container), so there is nothing different for a reader to write in one source file"
      },
      {
        "id": "read-resolve",
        "says": "Deserializing a Singleton creates a new object unless readResolve returns the existing instance.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "example:36-creational-patterns/README_9.1.1.md:2"
        ],
        "exercise": "secure-singleton",
        "reason": null
      },
      {
        "id": "reflection-guard",
        "says": "Reflection can call a private constructor, so a class-based Singleton's constructor refuses to run a second time.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "example:36-creational-patterns/README_9.1.1.md:1"
        ],
        "exercise": "holder-registry",
        "reason": null
      },
      {
        "id": "spring-scope",
        "says": "Spring's singleton scope is one cached bean per container, not the GoF pattern, and can be changed to prototype without touching the class.",
        "basis": [
          "section:Interview Q&A Section"
        ],
        "exercise": null,
        "reason": "a framework fact with no Spring on the practice classpath; the injected-service practice covers the constructor injection it relies on"
      },
      {
        "id": "static-init-order",
        "says": "Static initializers run in textual order, so a guard flag declared after the instance is reset by its own initializer and disables the guard.",
        "basis": [
          "section:Interview Q&A Section",
          "example:36-creational-patterns/README_9.1.1.md:13"
        ],
        "exercise": "secure-singleton",
        "reason": null
      },
      {
        "id": "volatile-dcl",
        "says": "Double-checked locking needs a volatile field, because without it another thread can see a reference to a partly constructed object.",
        "basis": [
          "section:Interview Q&A Section",
          "example:36-creational-patterns/README_9.1.1.md:3"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "weak-reference",
        "says": "A Singleton referenced only by a WeakReference can be collected, so it is held by a strong reference.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": null,
        "reason": "whether an object is collected depends on when the garbage collector runs, which no test can decide deterministically"
      }
    ],
