  "plan": {
    "plan_api": 2,
    "tier": "core",
    "count": 7,
    "aspects": [
      {
        "id": "async-dispatch",
        "says": "Notifications can be dispatched asynchronously on virtual threads for high-throughput event systems.",
        "basis": [
          "section:Relevant Java 21 Features"
        ],
        "exercise": null,
        "reason": "when an asynchronous observer runs is up to the scheduler, and virtual threads are practised in the concurrency modules"
      },
      {
        "id": "cascading-updates",
        "says": "A notifying flag, reset in finally, stops an observer's change from triggering an endless cascade of notifications.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "example:38-behavioral-patterns/README_9.3.2.md:3"
        ],
        "exercise": "reentrant-guard",
        "reason": null
      },
      {
        "id": "event-bus",
        "says": "An event bus keeps a listener list per event type in a ConcurrentHashMap, so a publish reaches only that type's listeners.",
        "basis": [
          "section:Interview Q&A Section",
          "example:38-behavioral-patterns/README_9.3.2.md:16",
          "example:38-behavioral-patterns/README_9.3.2.md:8"
        ],
        "exercise": "event-bus",
        "reason": null
      },
      {
        "id": "event-filtering",
        "says": "An observer can filter events by type with a predicate so it only handles what it cares about.",
        "basis": [
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": null,
        "reason": "incidental detail, not practised; per-type delivery is practised in event-bus"
      },
      {
        "id": "failing-observer",
        "says": "Wrapping each observer's call in try-catch keeps one throwing observer from stopping the others.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "snapshot-notify",
        "reason": null
      },
      {
        "id": "graceful-edges",
        "says": "A null observer or blank data is refused, while removing an unknown observer or notifying an empty list is a no-op.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "news-agency",
        "reason": null
      },
      {
        "id": "no-duplicates",
        "says": "A subject checks whether an observer is already registered before adding it, so no observer is notified twice.",
        "basis": [
          "section:Best Practices and Optimization Techniques",
          "example:38-behavioral-patterns/README_9.3.2.md:4"
        ],
        "exercise": "news-agency",
        "reason": null
      },
      {
        "id": "observable-deprecated",
        "says": "java.util.Observable was deprecated in Java 9 because it is a class rather than an interface, is not type-safe and leaves order and threading unspecified.",
        "basis": [
          "section:Interview Q&A Section",
          "example:38-behavioral-patterns/README_9.3.2.md:7"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "observer-vs-pubsub",
        "says": "Observer links a subject directly to its observers, Pub/Sub puts a broker between publishers and subscribers, and Mediator centralises interaction logic.",
        "basis": [
          "section:Interview Q&A Section",
          "example:38-behavioral-patterns/README_9.3.2.md:13",
          "example:38-behavioral-patterns/README_9.3.2.md:14"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "one-to-many",
        "says": "A subject keeps a list of observers, lets them register and unregister at runtime, and calls each one's update() when its state changes.",
        "basis": [
          "section:Concept Explanation",
          "example:38-behavioral-patterns/README_9.3.2.md:6"
        ],
        "exercise": "news-agency",
        "reason": null
      },
      {
        "id": "order-undefined",
        "says": "Notification order is generally undefined, so observers must not depend on being called in a particular order.",
        "basis": [
          "section:Key Points to Remember"
        ],
        "exercise": null,
        "reason": "a caution about what callers may assume, not a behaviour of the reader's code; the practices never grade one observer against another's position"
      },
      {
        "id": "push-pull",
        "says": "A subject can push data with each notification or let observers pull it, and a property-change listener gets old and new values only when the value really changes.",
        "basis": [
          "section:Key Points to Remember"
        ],
        "exercise": "observable-property",
        "reason": null
      },
      {
        "id": "snapshot-iteration",
        "says": "Notifying from a snapshot of the observer list lets an observer add or remove observers during update() without a ConcurrentModificationException.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "example:38-behavioral-patterns/README_9.3.2.md:2"
        ],
        "exercise": "snapshot-notify",
        "reason": null
      },
      {
        "id": "subscription-handle",
        "says": "Returning a subscription handle whose cancel() unregisters the listener is the explicit way to prevent observer memory leaks.",
        "basis": [
          "section:Interview Q&A Section",
          "example:38-behavioral-patterns/README_9.3.2.md:12"
        ],
        "exercise": "event-bus",
        "reason": null
      },
      {
        "id": "thread-safe-list",
        "says": "A CopyOnWriteArrayList makes the observer list thread-safe, with notifications iterating a snapshot and no lock held while observers run.",
        "basis": [
          "section:Interview Q&A Section",
          "example:38-behavioral-patterns/README_9.3.2.md:10"
        ],
        "exercise": "concurrent-subject",
        "reason": null
      },
      {
        "id": "unmodifiable-views",
        "says": "Published data exposed to clients is returned as an unmodifiable view or a copy, never the subject's own list.",
        "basis": [
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": "news-agency",
        "reason": null
      },
      {
        "id": "version-history",
        "says": "Observable dates from Java 1.0 and was deprecated in 9, CopyOnWriteArrayList came in 5 and lambdas in 8.",
        "basis": [
          "section:Evolution Across Java Versions"
        ],
        "exercise": null,
        "reason": "incidental detail, not practised"
      },
      {
        "id": "weak-references",
        "says": "Holding observers through WeakReference lets the garbage collector reclaim observers nobody else references.",
        "basis": [
          "section:Interview Q&A Section",
          "example:38-behavioral-patterns/README_9.3.2.md:11"
        ],
        "exercise": null,
        "reason": "whether a weakly held observer is collected depends on when the garbage collector runs, which no test can decide deterministically"
      }
    ],
