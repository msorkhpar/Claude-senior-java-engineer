  "plan": {
    "plan_api": 2,
    "tier": "core",
    "count": 8,
    "aspects": [
      {
        "id": "anymatch-intent",
        "says": "anyMatch states an existence check directly, where filter().findFirst().isPresent() says it the long way.",
        "basis": [
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": null,
        "reason": "Both forms return the same answer and stop at the first match, so no test can tell them apart; it is a matter of style."
      },
      {
        "id": "collect-not-foreach",
        "says": "A result list is built by collect or toList, not by a forEach that adds to an outside list.",
        "basis": [
          "example:16-streams-api/README_4.4.4.md:1",
          "example:16-streams-api/README_4.4.4.md:2"
        ],
        "exercise": "lookup-list",
        "reason": null
      },
      {
        "id": "find-first-any",
        "says": "findFirst returns the first element in encounter order, while findAny may return any element.",
        "basis": [
          "example:16-streams-api/README_4.4.4.md:16",
          "example:16-streams-api/README_4.4.4.md:17"
        ],
        "exercise": null,
        "reason": "The difference only shows on a parallel stream, where it is practised on the parallel streams page; on the sequential streams of this page both return the same element."
      },
      {
        "id": "foreach-ordered",
        "says": "forEach promises no order on a parallel stream; forEachOrdered keeps encounter order.",
        "basis": [
          "section:Key Points to Remember"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "grouping-downstream",
        "says": "groupingBy with a downstream collector counts, averages or maps the members of each group.",
        "basis": [
          "example:16-streams-api/README_4.4.4.md:13",
          "tests:16-streams-api/src/test/java/com/github/msorkhpar/claudejavatutor/streamsapi/TerminalOperationsTest.java"
        ],
        "exercise": "dept-report",
        "reason": null
      },
      {
        "id": "joining",
        "says": "joining writes its delimiter only between elements and its prefix and suffix even around nothing.",
        "basis": [
          "example:16-streams-api/README_4.4.4.md:19",
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "in-clause",
        "reason": null
      },
      {
        "id": "joining-cost",
        "says": "joining appends into one StringBuilder, where reduce with + builds a new String at every step.",
        "basis": [
          "example:16-streams-api/README_4.4.4.md:18"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "match-empty",
        "says": "On an empty stream allMatch and noneMatch are true and anyMatch is false.",
        "basis": [
          "example:16-streams-api/README_4.4.4.md:9",
          "section:Edge Cases and Their Handling",
          "tests:16-streams-api/src/test/java/com/github/msorkhpar/claudejavatutor/streamsapi/TerminalOperationsTest.java"
        ],
        "exercise": "empty-checks",
        "reason": null
      },
      {
        "id": "newer-extras",
        "says": "mapMulti and the sequenced-collection getFirst and getLast sit beside the terminal operations.",
        "basis": [
          "section:Relevant Java 21 Features"
        ],
        "exercise": null,
        "reason": "The page names these only in passing and gives them no example or rule to practise."
      },
      {
        "id": "optional-handled",
        "says": "The Optional from findFirst, min, max or reduce is handled with orElse, never with a bare get().",
        "basis": [
          "example:16-streams-api/README_4.4.4.md:5",
          "example:16-streams-api/README_4.4.4.md:6"
        ],
        "exercise": "reduce-kit",
        "reason": null
      },
      {
        "id": "partitioning",
        "says": "partitioningBy always yields both a true and a false entry.",
        "basis": [
          "section:Key Points to Remember",
          "tests:16-streams-api/src/test/java/com/github/msorkhpar/claudejavatutor/streamsapi/TerminalOperationsTest.java"
        ],
        "exercise": "dept-report",
        "reason": null
      },
      {
        "id": "primitive-reductions",
        "says": "Primitive streams reduce directly with sum, average and summaryStatistics.",
        "basis": [
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": "one-pass-stats",
        "reason": null
      },
      {
        "id": "reduce-identity",
        "says": "The identity of reduce must leave every element unchanged, and it is what an empty stream returns.",
        "basis": [
          "example:16-streams-api/README_4.4.4.md:3",
          "example:16-streams-api/README_4.4.4.md:4",
          "example:16-streams-api/README_4.4.4.md:11",
