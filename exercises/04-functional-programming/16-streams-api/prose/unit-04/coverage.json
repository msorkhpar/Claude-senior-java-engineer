        ],
        "exercise": "reduce-kit",
        "reason": null
      },
      {
        "id": "reduce-optional",
        "says": "Without an identity, reduce returns an Optional that is empty for an empty stream.",
        "basis": [
          "example:16-streams-api/README_4.4.4.md:11",
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "reduce-kit",
        "reason": null
      },
      {
        "id": "teeing",
        "says": "Collectors.teeing feeds two collectors in one pass and merges their results.",
        "basis": [
          "example:16-streams-api/README_4.4.4.md:21",
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": null,
        "reason": "Whether the minimum and maximum were found in one pass cannot be observed; one-pass-stats offers teeing as the page's tool and grades only the results."
      },
      {
        "id": "terminal-triggers",
        "says": "A terminal operation runs the lazy pipeline and leaves the stream spent.",
        "basis": [
          "section:Concept Explanation"
        ],
        "exercise": null,
        "reason": "Laziness and the single use of a stream are practised on the module's introduction page, and every practice here ends in a terminal operation."
      },
      {
        "id": "tolist-nulls",
        "says": "Stream.toList() returns an unmodifiable list that accepts nulls, where toUnmodifiableList() throws.",
        "basis": [
          "section:Relevant Java 21 Features"
        ],
        "exercise": "lookup-list",
        "reason": null
      },
      {
        "id": "tomap-duplicates",
        "says": "toMap throws IllegalStateException on a duplicate key unless it is given a merge function.",
        "basis": [
