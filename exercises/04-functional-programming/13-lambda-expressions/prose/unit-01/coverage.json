    "aspects": [
      {
        "id": "behavior-param",
        "says": "A lambda passes behaviour as an argument, replacing a verbose anonymous inner class such as a Comparator.",
        "basis": [
          "section:Key Points to Remember",
          "example:13-lambda-expressions/README_4.1.1.md:4",
          "example:13-lambda-expressions/README_4.1.1.md:6",
          "tests:13-lambda-expressions/src/test/java/com/github/msorkhpar/claudejavatutor/lambdaexpressions/LambdaIntroductionTest.java"
        ],
        "exercise": "name-sorter",
        "reason": null
      },
      {
        "id": "checked-exceptions",
        "says": "A lambda for Function or Consumer cannot throw a checked exception, so it handles the failure inside or goes through a wrapping interface.",
        "basis": [
          "example:13-lambda-expressions/README_4.1.1.md:2",
          "example:13-lambda-expressions/README_4.1.1.md:11",
          "example:13-lambda-expressions/README_4.1.1.md:12",
          "tests:13-lambda-expressions/src/test/java/com/github/msorkhpar/claudejavatutor/lambdaexpressions/LambdaIntroductionTest.java"
        ],
        "exercise": "safe-parser",
        "reason": null
      },
      {
        "id": "closure",
        "says": "A lambda closes over the values it reads, so each function made by a factory keeps its own values.",
        "basis": [
          "example:13-lambda-expressions/README_4.1.1.md:14",
          "example:13-lambda-expressions/README_4.1.1.md:15",
          "tests:13-lambda-expressions/src/test/java/com/github/msorkhpar/claudejavatutor/lambdaexpressions/LambdaIntroductionTest.java"
        ],
        "exercise": "closure-factory",
        "reason": null
      },
      {
        "id": "compiled-by-invokedynamic",
        "says": "A lambda is compiled to an invokedynamic call and its class is made at run time, while each anonymous class gets its own class file.",
        "basis": [
          "example:13-lambda-expressions/README_4.1.1.md:7",
          "example:13-lambda-expressions/README_4.1.1.md:16"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "effectively-final",
        "says": "A lambda may read a local variable only when it is final or effectively final, because it receives a copy of the value.",
        "basis": [
          "example:13-lambda-expressions/README_4.1.1.md:8",
          "example:13-lambda-expressions/README_4.1.1.md:9"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "functional-interface",
        "says": "A lambda can only implement a functional interface: one abstract method, with any number of default or static methods.",
        "basis": [
          "example:13-lambda-expressions/README_4.1.1.md:12",
          "example:13-lambda-expressions/README_4.1.1.md:13"
        ],
        "exercise": "calculator",
        "reason": null
      },
      {
        "id": "instance-fields",
        "says": "A lambda may update the enclosing object's fields, because they belong to the object and not to the method.",
        "basis": [
          "example:13-lambda-expressions/README_4.1.1.md:14",
          "example:13-lambda-expressions/README_4.1.1.md:15"
        ],
        "exercise": "tally",
        "reason": null
      },
      {
        "id": "java21-companions",
        "says": "Later Java versions add var in lambda parameters and pair lambdas with virtual threads and sequenced collections.",
        "basis": [
          "section:Relevant Java 21 Features"
        ],
        "exercise": null,
        "reason": "a survey of neighbouring features, each taught on its own page; var in lambda parameters belongs to the next lesson"
      },
      {
        "id": "keep-lambdas-short",
        "says": "A lambda longer than a few lines reads better extracted into a named method.",
        "basis": [
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": null,
        "reason": "a readability judgement no test can observe; the next lesson's eligible-users practice extracts a named predicate"
      },
      {
        "id": "lambda-cost",
        "says": "Lambdas cost little, though capturing lambdas made in tight loops can allocate, so hot paths are measured.",
        "basis": [
          "example:13-lambda-expressions/README_4.1.1.md:16"
        ],
        "exercise": null,
        "reason": "a claim about cost that no deterministic test can measure; the quiz's two questions go to compilation and to capture"
      },
      {
        "id": "method-references",
        "says": "A method reference such as String::compareTo is a shorter way to write a lambda that calls one existing method.",
        "basis": [
          "example:13-lambda-expressions/README_4.1.1.md:3"
        ],
        "exercise": null,
        "reason": "a style choice with identical behaviour, so no test can tell a method reference from its lambda; name-sorter's statement points at String::compareTo"
      },
      {
        "id": "no-side-effects",
        "says": "Mutating shared state from a lambda to get around effectively final is a bug waiting to happen; let a stream compute the result instead.",
        "basis": [
          "example:13-lambda-expressions/README_4.1.1.md:1",
          "example:13-lambda-expressions/README_4.1.1.md:8",
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": "match-counter",
        "reason": null
      },
      {
        "id": "null-and-empty",
        "says": "Null items and empty collections are handled in the pipeline before a lambda sees them.",
        "basis": [
          "example:13-lambda-expressions/README_4.1.1.md:5",
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "match-counter",
        "reason": null
      },
      {
        "id": "recursive-lambdas",
        "says": "A recursive lambda is possible but is usually clearer as a regular method.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": null,
        "reason": "an incidental design note the page does not develop, with no example to build on"
      },
      {
        "id": "target-typing",
        "says": "The compiler infers a lambda's parameter types from the functional interface the context expects.",
        "basis": [
          "section:Key Points to Remember",
          "example:13-lambda-expressions/README_4.1.1.md:4"
        ],
        "exercise": null,
        "reason": "the syntax lesson that follows practises target typing in each of its contexts, so it is not repeated here"
      },
      {
        "id": "this-scope",
        "says": "Inside a lambda, this is the enclosing object; inside an anonymous class, it is the anonymous object.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "example:13-lambda-expressions/README_4.1.1.md:7"
        ],
        "exercise": "tally",
        "reason": null
      }
