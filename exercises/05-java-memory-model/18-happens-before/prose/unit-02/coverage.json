      },
      {
        "id": "deserialization",
        "says": "Deserialization bypasses constructors, so the final-field guarantee does not apply automatically.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": null,
        "reason": "an incidental edge case with no example on the page; the course has no serialization material to practise it on"
      },
      {
        "id": "different-monitors",
        "says": "Locking different objects gives neither mutual exclusion nor happens-before, and a static synchronized method locks the Class object, not the instance.",
        "basis": [
          "example:18-happens-before/README_5.2.2.md:1",
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "ledger",
        "reason": null
      },
      {
        "id": "final-field-rule",
        "says": "Final fields of a properly constructed object are visible to any thread that gets the reference, unless this escaped the constructor.",
        "basis": [
          "section:5.2.2.3. Final Fields",
          "example:18-happens-before/README_5.2.2.md:5"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "final-monitor",
        "says": "A monitor should be a private final reference, so every thread locks the same object.",
        "basis": [
          "example:18-happens-before/README_5.2.2.md:7",
          "example:18-happens-before/README_5.2.2.md:8"
        ],
        "exercise": "ledger",
        "reason": null
      },
      {
        "id": "immutable-publication",
        "says": "An object whose fields are all final needs only safe publication of its reference, and no lock to be read.",
        "basis": [
          "section:Best Practices and Optimization Techniques",
          "example:18-happens-before/README_5.2.2.md:14"
        ],
        "exercise": "config",
        "reason": null
      },
      {
        "id": "long-atomic",
        "says": "volatile makes long and double reads and writes atomic.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": null,
        "reason": "tearing happens only on 32-bit JVMs, which the 64-bit runner cannot show, so no test can observe it"
      },
      {
        "id": "release-on-exception",
        "says": "A synchronized block releases its monitor even when an exception leaves it.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "ledger",
        "reason": null
      },
      {
        "id": "safe-publication",
        "says": "Safe publication is a static initializer, a volatile field, a lock-guarded field or a final field.",
        "basis": [
          "example:18-happens-before/README_5.2.2.md:15"
        ],
        "exercise": "config",
        "reason": null
      },
      {
        "id": "sync-two-guarantees",
        "says": "synchronized gives both mutual exclusion and visibility: an unlock happens-before the next lock of the same monitor.",
        "basis": [
          "section:5.2.2.1. Synchronized Methods and Blocks",
