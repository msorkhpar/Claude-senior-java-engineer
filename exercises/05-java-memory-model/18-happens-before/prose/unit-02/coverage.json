    "aspects": [
      {
        "id": "dcl",
        "says": "Double-checked locking is correct only with a volatile field and a second check under the lock.",
        "basis": [
          "example:18-happens-before/README_5.2.2.md:17",
          "example:18-happens-before/README_5.2.2.md:18"
        ],
        "exercise": null,
