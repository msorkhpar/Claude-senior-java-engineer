      "id": "practice.DataRacesTest#startAndJoinOrderTheAccesses",
      "kind": "edge",
      "says": "Accesses ordered by thread start or thread join are not races, though they are in different threads."
    },
    {
      "id": "practice.DataRacesTest#onlyTheSameMonitorOrdersTheAccesses",
      "kind": "edge",
      "says": "An unlock orders only the later locks of the same monitor, so accesses under two different locks still race."
    },
    {
      "id": "practice.DataRacesTest#aVolatileWriteOrdersOnlyLaterReadsOfIt",
      "kind": "edge",
      "says": "A volatile write orders only the later reads of that same variable, so another flag, or a read that came first, leaves the race."
    }
