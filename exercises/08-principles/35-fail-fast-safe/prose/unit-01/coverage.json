    "aspects": [
      {
        "id": "best-effort",
        "says": "Fail-fast detection is best-effort: modCount is not volatile, so it is no guarantee across threads and no basis for correctness.",
        "basis": [
          "section:Key Points to Remember"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "cow-no-remove",
        "says": "A CopyOnWriteArrayList iterator does not support remove() and throws UnsupportedOperationException.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": null,
        "reason": "asked on 8.5.2's quiz, the page that explains why a snapshot iterator cannot remove"
      },
      {
        "id": "fail-safe-kinds",
        "says": "Fail-safe iterators never throw ConcurrentModificationException: CopyOnWriteArrayList iterates a snapshot, while ConcurrentHashMap is weakly consistent.",
        "basis": [
          "section:Fail-Safe (Weakly Consistent) Iterators",
          "tests:35-fail-fast-safe/src/test/java/com/github/msorkhpar/claudejavatutor/failfastsafe/FailSafeIteratorDemoTest.java"
        ],
        "exercise": null,
        "reason": "practised on 8.5.2, whose listener-registry practice grades the snapshot and whose quiz asks about weakly consistent traversal"
      },
      {
        "id": "java21",
        "says": "Sequenced collections keep the iterator contract of the collection underneath.",
        "basis": [
          "section:Relevant Java 21 Features"
        ],
        "exercise": null,
        "reason": "incidental detail, not practised"
      },
      {
        "id": "modcount",
        "says": "A fail-fast iterator copies the collection's modCount when it is created, and next() throws ConcurrentModificationException once a structural change made outside the iterator moves it.",
        "basis": [
          "section:Fail-Fast Iterators",
          "section:Interview Q&A Section",
          "tests:35-fail-fast-safe/src/test/java/com/github/msorkhpar/claudejavatutor/failfastsafe/FailFastIteratorDemoTest.java"
        ],
        "exercise": "tiny",
        "reason": null
      },
      {
        "id": "remove-contract",
        "says": "Iterator.remove() removes the element next() last returned, re-syncs the iterator's expected count, and throws IllegalStateException without a preceding next().",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "section:Interview Q&A Section"
        ],
        "exercise": "tiny",
        "reason": null
      },
      {
        "id": "remove-while-iterating",
        "says": "Elements are removed during a traversal through Iterator.remove() or removeIf, never through the collection's own remove().",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "section:Key Points to Remember",
          "tests:35-fail-fast-safe/src/test/java/com/github/msorkhpar/claudejavatutor/failfastsafe/FailFastIteratorDemoTest.java"
        ],
        "exercise": "purge",
        "reason": null
      },
      {
        "id": "removeif-map",
        "says": "removeIf, also on a map's entrySet(), is the concise, preferred way to remove matching entries in place.",
        "basis": [
          "section:Best Practices and Optimization Techniques",
          "section:Interview Q&A Section"
        ],
        "exercise": "scores",
        "reason": null
      },
      {
        "id": "silent-skip",
        "says": "A for-each loop that removes through the collection usually throws, but removing the second-to-last element ends the loop silently and skips the last one.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "single-thread",
        "says": "ConcurrentModificationException is about modification during iteration, and happens in single-threaded code.",
        "basis": [
          "section:Interview-specific Insights"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "synchronized-wrapper",
        "says": "Collections.synchronizedList still hands out a fail-fast iterator, so a traversal holds the wrapper's own lock for its whole length.",
        "basis": [
          "section:Key Points to Remember",
          "section:Common Pitfalls and How to Avoid Them",
