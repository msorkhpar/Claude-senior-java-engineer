        "reason": null
      },
      {
        "id": "hide-details",
        "says": "Abstraction hides implementation details and exposes only an object's essential features.",
        "basis": [
          "section:Concept Overview",
          "example:08-object-oriented/README_2.3.3.md:4"
        ],
        "exercise": null,
        "reason": "the idea every practice on this page applies rather than one a test checks alone; 'An inventory whose abstraction does not leak' checks its sharpest form"
      },
      {
        "id": "leaky-abstraction",
        "says": "An abstraction must not leak its implementation, for example by handing callers the collection that holds its state.",
