      },
      {
        "id": "normalize-unicode",
        "says": "Unicode input is normalized (NFC or NFKC) before validation; normalization does not stop homoglyphs, so the allowed character set stays restricted.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "signup-validation",
        "reason": null
      },
      {
        "id": "null-and-blank",
        "says": "Nulls are refused with Objects.requireNonNull and blank strings are checked with isBlank().",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": null,
        "reason": "incidental detail; signup-validation and defensive-origins refuse null input as part of their contracts"
      },
      {
        "id": "path-traversal",
        "says": "A user-supplied path is resolved against the base, normalized and checked with Path.startsWith, and existing paths are checked again on their real paths because normalize() does not follow links.",
        "basis": [
          "section:Interview Q&A Section",
          "example:44-java-security/README_10.6.1.md:11",
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "safe-path",
        "reason": null
      },
      {
