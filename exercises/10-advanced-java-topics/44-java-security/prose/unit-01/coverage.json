        "reason": null
      },
      {
        "id": "least-privilege",
        "says": "Least privilege: the narrowest access modifiers, exported packages and sealed hierarchies, and minimal database, file and container permissions.",
        "basis": [
          "section:Interview Q&A Section",
          "example:44-java-security/README_10.6.1.md:16",
          "example:44-java-security/README_10.6.1.md:17"
        ],
        "exercise": null,
        "reason": "a design principle whose code form (private, sealed, final) the compiler enforces, and whose operational forms lie outside Java code; sealed types are practised in module 10"
      },
      {
        "id": "masking",
        "says": "Sensitive values such as card numbers and emails are masked before being logged or shown.",
        "basis": [
          "section:Key Points to Remember"
        ],
        "exercise": null,
        "reason": "the page lists masking in one bullet without a rule for the masked form, so no format can be graded from the page"
      },
      {
        "id": "no-secrets-in-logs",
        "says": "Sensitive data such as passwords never goes into log messages.",
