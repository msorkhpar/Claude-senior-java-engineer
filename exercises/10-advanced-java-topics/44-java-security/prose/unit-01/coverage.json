          "section:Relevant Java 21 Features"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "sql-parameters",
        "says": "SQL values are bound as PreparedStatement parameters, never concatenated.",
        "basis": [
          "section:1. String concatenation in SQL queries",
          "example:44-java-security/README_10.6.1.md:1"
        ],
        "exercise": null,
        "reason": "practised on 10.6.2 (SQL injection) and in 45-java-persistence 10.7.1 (safe-search), with a live database"
      },
      {
        "id": "static-patterns",
        "says": "Validation patterns are compiled once as static final fields.",
        "basis": [
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": null,
        "reason": "a performance habit; recompiling a pattern gives the same answers, so no test can tell the two apart"
      },
      {
        "id": "try-with-resources",
        "says": "Try-with-resources closes streams on every path, preventing resource exhaustion.",
        "basis": [
