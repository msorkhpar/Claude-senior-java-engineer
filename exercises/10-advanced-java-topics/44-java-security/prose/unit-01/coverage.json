          "example:44-java-security/README_10.6.1.md:9"
        ],
        "exercise": "password-wipe",
        "reason": null
      },
      {
        "id": "defense-in-depth",
        "says": "Validation is repeated at every boundary (API, service, persistence) rather than trusted to one layer.",
        "basis": [
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "defensive-copy",
        "says": "Mutable collections are copied when they cross a trust boundary, in the constructor and in the getter, and List.copyOf does both and refuses nulls.",
