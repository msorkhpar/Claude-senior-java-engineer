  "plan": {
    "plan_api": 2,
    "tier": "core",
    "count": 4,
    "aspects": [
      {
        "id": "allocation-pressure",
        "says": "Reusing large buffers in hot loops avoids short-lived large allocations that pressure or bypass the young generation.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "example:40-memory-management/README_10.2.2.md:4"
        ],
        "exercise": null,
        "reason": "its effect shows only in GC activity and timing, which no test can grade deterministically"
      },
      {
        "id": "collector-choice",
        "says": "Parallel GC maximises throughput, G1 balances latency and throughput as the default, and ZGC keeps pauses under a millisecond on huge heaps.",
        "basis": [
          "section:Modern GC Implementations",
          "example:40-memory-management/README_10.2.2.md:11"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "compaction",
        "says": "Mark-and-compact moves survivors together to remove fragmentation, which allows bump-pointer allocation at the price of copying.",
        "basis": [
          "section:Mark-and-Compact"
        ],
        "exercise": null,
        "reason": "memory layout is not visible from Java code, and a simulation of moving addresses would practise arithmetic rather than the idea"
      },
      {
        "id": "g1-internals",
        "says": "G1 splits the heap into regions, collects the regions with most garbage first within a pause target, and allocates objects over half a region as humongous.",
        "basis": [
          "section:Edge Cases and Their Handling",
          "example:40-memory-management/README_10.2.2.md:17"
        ],
        "exercise": null,
        "reason": "collector internals that code cannot observe deterministically; the quiz covers choosing between collectors"
      },
      {
        "id": "generational",
        "says": "Generational GC allocates in Eden, ages survivors of minor GCs through the survivor space and promotes them to the old generation past a tenuring threshold.",
        "basis": [
          "section:Generational Garbage Collection",
          "example:40-memory-management/README_10.2.2.md:9"
        ],
        "exercise": "generations",
        "reason": null
      },
      {
        "id": "java21-gc",
        "says": "Java 21 adds generational ZGC as an option and deprecates finalization for removal.",
        "basis": [
          "section:Relevant Java 21 Features"
        ],
        "exercise": null,
        "reason": "incidental detail, not practised"
      },
      {
        "id": "mark-and-sweep",
        "says": "Mark-and-sweep marks everything reachable from the roots, skipping objects already marked, then frees the unmarked and clears the survivors' marks.",
        "basis": [
          "section:Interview Q&A Section",
          "example:40-memory-management/README_10.2.2.md:7"
        ],
        "exercise": "mark-and-sweep",
        "reason": null
      },
      {
        "id": "minor-major",
        "says": "A minor GC collects only the young generation, while a major or full GC also collects the old generation.",
        "basis": [
          "section:Generational Garbage Collection"
        ],
        "exercise": "generations",
        "reason": null
      },
      {
        "id": "no-finalize",
        "says": "finalize() is deprecated and unreliable; cleanup belongs in close() with try-with-resources, with a Cleaner as a safety net that runs at most once.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "example:40-memory-management/README_10.2.2.md:2"
        ],
        "exercise": "cleaner-resource",
        "reason": null
      },
      {
        "id": "reachability",
        "says": "The JVM decides garbage by reachability from GC roots, not by reference counts, so an unreachable cycle is collected.",
        "basis": [
          "section:Mark-and-Sweep Algorithm",
          "example:40-memory-management/README_10.2.2.md:13"
        ],
        "exercise": "mark-and-sweep",
        "reason": null
      },
      {
        "id": "system-gc",
        "says": "System.gc() is only a request the JVM may ignore, and when honoured it usually means a costly full collection.",
        "basis": [
          "section:Interview Q&A Section",
          "example:40-memory-management/README_10.2.2.md:19"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "tuning-and-monitoring",
        "says": "GC tuning starts from defaults and GC logs, changes one flag at a time, and can be watched through the GarbageCollector and Memory MXBeans.",
        "basis": [
          "section:Best Practices and Optimization Techniques",
          "example:40-memory-management/README_10.2.2.md:15"
        ],
        "exercise": null,
        "reason": "JVM flags and live counters differ from run to run, so there is nothing a test can check the same way twice"
      }
