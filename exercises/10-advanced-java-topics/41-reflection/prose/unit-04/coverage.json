        ],
        "exercise": "method-handles",
        "reason": null
      },
      {
        "id": "overhead-sources",
        "says": "Reflection costs come from lookup, access checks, boxing and the Object[] array, and JIT barriers, roughly 2-20x for cached and 100-1000x for uncached calls.",
        "basis": [
          "section:Key Points to Remember",
          "example:41-reflection/README_10.3.4.md:7",
          "example:41-reflection/README_10.3.4.md:6"
        ],
        "exercise": null,
        "reason": "speed can only be measured by timing, which is not deterministic; the practices grade the behaviours that remove the costs (caching, accessible once, typed handles)"
      },
      {
