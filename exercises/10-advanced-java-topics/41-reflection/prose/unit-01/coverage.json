        ],
        "exercise": "class-lookup",
        "reason": null
      },
      {
        "id": "forname-init",
        "says": "Class.forName(name) runs the static initializer, while forName(name, false, loader) loads the class without initializing it.",
        "basis": [
          "section:Interview Q&A Section",
          "example:41-reflection/README_10.3.1.md:15"
        ],
        "exercise": "class-lookup",
        "reason": null
      },
      {
