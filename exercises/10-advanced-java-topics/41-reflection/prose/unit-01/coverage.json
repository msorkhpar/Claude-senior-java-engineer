          "section:Interview Q&A Section",
          "example:41-reflection/README_10.3.1.md:9",
          "example:41-reflection/README_10.3.1.md:3"
        ],
        "exercise": "hierarchy-walk",
        "reason": null
      },
      {
        "id": "interfaces-shallow",
        "says": "getInterfaces() returns only directly declared interfaces, so all interfaces need a recursive walk over superclasses and super-interfaces.",
        "basis": [
          "section:Interview Q&A Section",
          "example:41-reflection/README_10.3.1.md:9"
        ],
        "exercise": "hierarchy-walk",
        "reason": null
      },
      {
        "id": "is-instance",
        "says": "Class.isInstance(obj) is the runtime instanceof: polymorphic, and false for null.",
        "basis": [
          "section:Interview Q&A Section",
