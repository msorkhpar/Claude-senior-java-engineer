    "aspects": [
      {
        "id": "constructor-newinstance",
        "says": "Constructor.newInstance can call any constructor with arguments, private ones after setAccessible, where Class.newInstance only calls the no-arg one.",
        "basis": [
          "section:Interview Q&A Section",
          "example:41-reflection/README_10.3.2.md:12"
        ],
        "exercise": "constructor-call",
        "reason": null
      },
      {
        "id": "exact-types",
        "says": "Method and constructor lookup needs the exact parameter types, so Integer.class does not find an int parameter, and overloads are told apart by their types.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "example:41-reflection/README_10.3.2.md:4",
          "example:41-reflection/README_10.3.2.md:14"
        ],
        "exercise": "method-lookup",
        "reason": null
      },
      {
        "id": "field-injection",
        "says": "A DI framework injects a private field by finding fields that carry its annotation, calling setAccessible(true) and Field.set.",
        "basis": [
          "section:Interview Q&A Section",
          "example:41-reflection/README_10.3.2.md:18"
        ],
        "exercise": "field-injection",
        "reason": null
      },
      {
        "id": "final-fields",
        "says": "A static final or record field cannot be set by reflection, and a compile-time constant is inlined so changing it is invisible.",
        "basis": [
          "section:Interview-specific Insights",
          "example:41-reflection/README_10.3.2.md:5"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "handles-alternative",
        "says": "MethodHandles.privateLookupIn and VarHandle are module-aware, faster alternatives to setAccessible and Field.",
        "basis": [
          "section:Relevant Java 21 Features"
        ],
        "exercise": null,
        "reason": "practised on the performance page (10.3.4), whose method-handles practice uses privateLookupIn"
      },
      {
        "id": "inherited-field",
        "says": "getDeclaredField does not search superclasses, so an inherited field is found by walking the hierarchy.",
        "basis": [
          "section:Edge Cases and Their Handling",
          "example:41-reflection/README_10.3.2.md:6"
        ],
        "exercise": "field-access",
        "reason": null
      },
      {
        "id": "member-families",
        "says": "getMethods() and getConstructors() return public members only, while the getDeclared...() family returns the class's own members at every access level.",
        "basis": [
          "section:Concept Explanation"
        ],
        "exercise": "method-lookup",
        "reason": null
      },
      {
        "id": "module-opens",
        "says": "Deep reflection into a named module needs an opens directive or --add-opens, and since JDK 16 fails with InaccessibleObjectException otherwise.",
        "basis": [
          "section:Interview Q&A Section",
          "example:41-reflection/README_10.3.2.md:16"
        ],
        "exercise": null,
        "reason": "the practices run on the classpath in the unnamed module, so a module boundary cannot be set up in one source file; the Class and Object Introspection quiz asks what a closed package does"
      },
      {
        "id": "parameter-names",
        "says": "Parameter.getName() gives real names only when the code is compiled with -parameters.",
        "basis": [
          "section:Key Points to Remember"
        ],
        "exercise": null,
        "reason": "incidental detail, not practised; it depends on a compiler flag the fixed practice build does not set"
      },
      {
