  "plan": {
    "plan_api": 2,
    "tier": "core",
    "count": 7,
    "aspects": [
      {
        "id": "array-vs-linked-list",
        "says": "ArrayList gives O(1) random access and cache-friendly storage, LinkedList O(1) work at its ends, and ArrayList or ArrayDeque is usually the better default.",
        "basis": [
          "section:Lists",
          "example:39-data-structures/README_10.1.1.md:7"
        ],
        "exercise": null,
        "reason": "the difference is speed and memory, which a test could only grade by timing; both lists give the same results"
      },
      {
        "id": "bfs-shortest-path",
        "says": "Breadth-first search over an adjacency list, with a visited set, visits each vertex once and finds a shortest path in an unweighted graph.",
        "basis": [
          "section:Graphs",
          "example:39-data-structures/README_10.1.1.md:15"
        ],
        "exercise": "graph-search",
        "reason": null
      },
      {
        "id": "bst-height",
        "says": "A tree's height counts edges on its longest root-to-leaf path, so one node has height 0 and an empty tree -1.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "bst-traversals",
        "reason": null
      },
      {
        "id": "bst-traversals",
        "says": "In a binary search tree in-order traversal gives sorted values, pre-order puts the root first, post-order last, and level order goes breadth-first with a queue.",
        "basis": [
          "section:Trees",
          "example:39-data-structures/README_10.1.1.md:11"
        ],
        "exercise": "bst-traversals",
        "reason": null
      },
      {
        "id": "concurrent-modification",
        "says": "Removing from a list inside a for-each loop is a bug that may throw ConcurrentModificationException; Iterator.remove or removeIf are the safe ways.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "example:39-data-structures/README_10.1.1.md:3"
        ],
        "exercise": null,
        "reason": "the page itself says the fail-fast check is best-effort, so a test cannot rely on it, and the fix is a single library call"
      },
      {
        "id": "cycle-detection",
        "says": "Cycle detection in a directed graph needs a recursion-stack set beside the visited set, and a search started from every vertex to reach disconnected parts.",
        "basis": [
          "section:Edge Cases and Their Handling",
          "example:39-data-structures/README_10.1.1.md:15"
        ],
        "exercise": "directed-cycle",
        "reason": null
      },
      {
        "id": "directed-edges",
        "says": "In a directed graph an edge goes one way, while an undirected edge is stored in both vertices' neighbour sets.",
        "basis": [
          "section:Graphs"
        ],
        "exercise": "graph-search",
        "reason": null
      },
      {
        "id": "equals-not-identity",
        "says": "Collections compare elements with equals, never with ==, so lookups work for equal objects that are not the same instance.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "example:39-data-structures/README_10.1.1.md:1"
        ],
        "exercise": "tag-keys",
        "reason": null
      },
      {
        "id": "hash-contract",
        "says": "Hash collections find a key by hashCode and then equals, so equal objects must have equal hash codes or a HashSet keeps duplicates and misses lookups.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "example:39-data-structures/README_10.1.1.md:2"
        ],
        "exercise": "tag-keys",
        "reason": null
      },
      {
        "id": "hashmap-treeification",
        "says": "HashMap turns a bucket holding 8 colliding entries into a red-black tree once the table has 64 buckets, improving lookups among Comparable keys to O(log n).",
        "basis": [
          "section:Interview Q&A Section"
        ],
        "exercise": null,
        "reason": "an internal layout that HashMap's public API never shows, so a reader's code cannot be graded on it"
      },
      {
        "id": "java21-collections",
        "says": "Java 21's sequenced collections add first, last and reversed views, and List.of, Set.of and Map.of refuse nulls.",
        "basis": [
          "section:Relevant Java 21 Features"
        ],
        "exercise": null,
        "reason": "incidental detail, not practised"
      },
      {
        "id": "lru-access-order",
        "says": "A LinkedHashMap in access order with removeEldestEntry is an LRU cache: get counts as a use and the least recently used entry is evicted.",
        "basis": [
          "section:Maps",
          "example:39-data-structures/README_10.1.1.md:19"
        ],
        "exercise": "lru-cache",
        "reason": null
      },
      {
        "id": "map-helpers",
        "says": "computeIfAbsent, merge, pre-sizing and EnumMap/EnumSet are the page's everyday map and set idioms.",
        "basis": [
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": null,
        "reason": "incidental detail, not practised"
      },
      {
        "id": "matrix-or-list",
        "says": "An adjacency matrix gives O(1) edge lookup in O(V^2) space, an adjacency list O(V + E) space, so density decides between them.",
        "basis": [
          "section:Graphs"
        ],
        "exercise": null,
        "reason": "a space trade-off with the same answers either way; graph-search practises the adjacency list the page recommends for sparse graphs"
      },
      {
        "id": "mutable-key",
        "says": "Changing a HashMap key after it was put changes its hash, so the entry can no longer be found.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "example:39-data-structures/README_10.1.1.md:4"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "treeset-navigation",
        "says": "A TreeSet keeps elements sorted and answers range queries with subSet and neighbour queries with ceiling and floor, which include an equal element.",
        "basis": [
          "section:Sets",
          "example:39-data-structures/README_10.1.1.md:13"
        ],
        "exercise": "score-ranges",
        "reason": null
      },
      {
        "id": "view-or-copy",
        "says": "Collections.unmodifiableSet is a read-only view that shows later changes to the original, while Set.copyOf and Set.of are immutable copies.",
        "basis": [
          "section:Interview Q&A Section",
          "example:39-data-structures/README_10.1.1.md:17"
        ],
        "exercise": "quiz",
        "reason": null
      }
    ],
