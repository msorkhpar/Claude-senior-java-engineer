  "plan": {
    "plan_api": 2,
    "tier": "core",
    "count": 7,
    "aspects": [
      {
        "id": "atomicity",
        "says": "A transaction is all or nothing: the transfer's debit and credit both commit or both roll back.",
        "basis": [
          "section:ACID Properties",
          "example:45-java-persistence/README_10.7.3.md:8"
        ],
        "exercise": "atomic-transfer",
        "reason": null
      },
      {
        "id": "choose-locking",
        "says": "Optimistic locking suits low contention and long user think-time; pessimistic locking suits short, high-contention writes.",
        "basis": [
          "section:Interview Q&A Section",
          "example:45-java-persistence/README_10.7.3.md:12"
        ],
        "exercise": null,
        "reason": "a design choice about workload, which no single test can decide; both mechanisms are practised"
      },
      {
        "id": "commit-failure",
        "says": "If the connection fails during commit, the transaction may or may not have committed, so the result is checked or an idempotency key is used.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "consistency-guard",
        "says": "Consistency is kept by the statement itself: the debit's WHERE balance >= ? refuses to go below zero.",
        "basis": [
          "section:Interview Q&A Section",
          "example:45-java-persistence/README_10.7.3.md:8"
        ],
        "exercise": "atomic-transfer",
        "reason": null
      },
      {
        "id": "distributed",
        "says": "Transactions across several databases need two-phase commit or the saga pattern.",
        "basis": [
          "section:Key Points to Remember"
        ],
        "exercise": null,
        "reason": "needs more than one database system, beyond a single in-memory H2"
      },
      {
        "id": "durability",
        "says": "Durability means a committed change survives a crash, through the write-ahead log.",
        "basis": [
          "section:ACID Properties"
        ],
        "exercise": null,
        "reason": "a crash cannot be simulated against an in-memory database, so no test can observe it"
      },
      {
        "id": "isolation-anomalies",
        "says": "Dirty, non-repeatable and phantom reads are the anomalies each isolation level allows or prevents.",
        "basis": [
          "section:Transaction Isolation Levels",
          "example:45-java-persistence/README_10.7.3.md:10"
        ],
        "exercise": "isolation-reads",
        "reason": null
      },
      {
        "id": "lock-ordering",
        "says": "Deadlocks are prevented by always acquiring locks in one global order, such as ascending primary key.",
        "basis": [
          "section:2. Deadlocks from Inconsistent Lock Ordering",
          "example:45-java-persistence/README_10.7.3.md:3",
          "example:45-java-persistence/README_10.7.3.md:18"
        ],
        "exercise": "ordered-locking",
        "reason": null
      },
      {
        "id": "lock-timeout-retry",
        "says": "Lock timeouts and application-level retries with backoff handle deadlock victims and optimistic lock failures.",
        "basis": [
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": null,
        "reason": "a timeout needs a wall-clock wait and backoff needs randomness and sleeping, neither of which a deterministic test can grade"
      },
      {
        "id": "manual-commit",
        "says": "setAutoCommit(false) starts a manual transaction that ends with commit() or rollback().",
        "basis": [
          "section:Key Points to Remember"
        ],
        "exercise": "atomic-transfer",
        "reason": null
      },
      {
        "id": "nested-transactions",
        "says": "JDBC has no nested transactions; savepoints simulate a partial rollback.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "savepoint-import",
        "reason": null
      },
      {
        "id": "optimistic-locking",
        "says": "Optimistic locking checks and increments a version in the UPDATE, and an update of zero rows is a conflict, including a deleted row.",
        "basis": [
          "section:Optimistic vs. Pessimistic Locking",
          "example:45-java-persistence/README_10.7.3.md:12"
        ],
        "exercise": "optimistic-version",
        "reason": null
      },
      {
        "id": "pessimistic-locking",
        "says": "Pessimistic locking reads with SELECT ... FOR UPDATE, holding a write lock until commit or rollback.",
        "basis": [
          "section:Optimistic vs. Pessimistic Locking",
          "example:45-java-persistence/README_10.7.3.md:12"
        ],
        "exercise": "ordered-locking",
        "reason": null
      },
      {
        "id": "restore-autocommit",
        "says": "autoCommit is restored in a finally block, so a pooled connection is not handed on in manual mode.",
        "basis": [
          "section:1. Forgetting to Restore AutoCommit",
          "example:45-java-persistence/README_10.7.3.md:2"
        ],
        "exercise": "safe-rollback",
        "reason": null
      },
      {
        "id": "right-isolation-level",
        "says": "The lowest isolation level that meets the need is used, since SERIALIZABLE everywhere causes locking and deadlocks.",
        "basis": [
          "section:5. Using Wrong Isolation Level",
          "example:45-java-persistence/README_10.7.3.md:6"
        ],
        "exercise": null,
        "reason": "a performance and contention trade-off with no deterministic behaviour to grade; isolation-reads shows what each level allows"
      },
      {
        "id": "savepoints",
        "says": "A savepoint allows a partial rollback inside a transaction, such as skipping one bad record of an import.",
        "basis": [
          "section:Interview Q&A Section",
          "example:45-java-persistence/README_10.7.3.md:14"
        ],
        "exercise": "savepoint-import",
        "reason": null
      },
      {
        "id": "short-transactions",
        "says": "Transactions stay short: no waiting for user input while locks are held.",
        "basis": [
          "section:3. Long-Running Transactions",
          "example:45-java-persistence/README_10.7.3.md:4"
        ],
        "exercise": null,
        "reason": "the harm is lock hold time under real concurrency, which cannot be graded without timing"
      },
      {
        "id": "spring-transactional",
        "says": "@Transactional works through a proxy, so a call from inside the same class bypasses it and gets no new transaction.",
        "basis": [
          "section:Interview Q&A Section",
          "example:45-java-persistence/README_10.7.3.md:16"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "suppressed-rollback",
        "says": "A rollback that fails is attached to the original exception with addSuppressed, so the real cause is not lost.",
        "basis": [
          "section:4. Swallowing Rollback Exceptions",
          "example:45-java-persistence/README_10.7.3.md:5"
        ],
        "exercise": "safe-rollback",
        "reason": null
      },
      {
        "id": "virtual-threads",
        "says": "Virtual threads make waiting on the database cheap, but the pool still caps the number of open transactions.",
        "basis": [
          "section:Relevant Java 21 Features",
          "example:45-java-persistence/README_10.7.3.md:1"
        ],
        "exercise": null,
        "reason": "incidental detail, not practised; virtual threads have their own module in the course"
      }
