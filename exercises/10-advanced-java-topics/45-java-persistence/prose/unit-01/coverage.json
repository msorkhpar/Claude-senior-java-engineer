    "aspects": [
      {
        "id": "batching",
        "says": "addBatch() and executeBatch() send many rows in one round trip, executed in chunks for very large inputs.",
        "basis": [
          "section:4. Not Using Batch for Bulk Operations",
          "example:45-java-persistence/README_10.7.1.md:5",
          "example:45-java-persistence/README_10.7.1.md:16"
        ],
        "exercise": "batch-insert",
        "reason": null
      },
      {
        "id": "columns-by-name",
        "says": "Reading columns by name is preferred over indices, which are 1-based and break when the SELECT changes.",
        "basis": [
          "section:5. Using 0-Based Column Index",
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": "nullable-columns",
        "reason": null
      },
      {
        "id": "connection-pooling",
        "says": "A connection pool hands out reused connections and close() returns one to the pool instead of closing it; DataSource is preferred to DriverManager.",
        "basis": [
          "section:Interview Q&A Section",
          "example:45-java-persistence/README_10.7.1.md:18"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "driver-autoload",
        "says": "Since JDBC 4.0 drivers register themselves through ServiceLoader, so Class.forName is no longer needed.",
        "basis": [
          "section:Key Points to Remember"
        ],
        "exercise": null,
        "reason": "nothing for a reader to write: the practices already get their H2 connection without loading the driver"
      },
      {
        "id": "empty-result-set",
        "says": "An empty ResultSet returns false on the first next(), so code checks it before reading.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "row-position",
        "reason": null
      },
      {
        "id": "exception-chain",
        "says": "SQLException chains further exceptions, read with getNextException().",
        "basis": [
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": null,
        "reason": "incidental detail, not practised"
      },
      {
        "id": "fetch-size",
        "says": "setFetchSize controls how many rows a large result streams at a time, to bound memory.",
        "basis": [
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": null,
        "reason": "a memory and round-trip effect that an in-memory database does not show, so no test can observe it"
      },
      {
        "id": "generated-keys",
        "says": "An auto-increment key is read back with Statement.RETURN_GENERATED_KEYS and getGeneratedKeys().",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "generated-keys",
        "reason": null
      },
      {
        "id": "java21-features",
        "says": "Text blocks, records and virtual threads suit JDBC code, though the pool still caps how many queries run at once.",
        "basis": [
          "section:Relevant Java 21 Features",
          "example:45-java-persistence/README_10.7.1.md:1"
        ],
        "exercise": null,
        "reason": "incidental detail, not practised; the practices use records for rows"
      },
      {
        "id": "manual-transaction",
        "says": "setAutoCommit(false) starts a manual transaction that ends with commit() or rollback().",
        "basis": [
          "section:Key Points to Remember"
        ],
        "exercise": null,
        "reason": "practised on the transactions page (10.7.3), which is about exactly this"
      },
      {
        "id": "metadata",
        "says": "ResultSetMetaData gives the column names, types and sizes of a result at run time.",
        "basis": [
          "section:Key Points to Remember"
        ],
        "exercise": null,
        "reason": "incidental detail, not practised"
      },
      {
        "id": "money-bigdecimal",
        "says": "Money is bound and read as BigDecimal (SQL DECIMAL), never as a double.",
        "basis": [
          "section:Interview Q&A Section",
          "example:45-java-persistence/README_10.7.1.md:8"
        ],
        "exercise": "safe-search",
        "reason": null
      },
      {
        "id": "not-thread-safe",
        "says": "A ResultSet is not thread-safe, so each thread uses its own connection and statement.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": null,
        "reason": "a race on a shared ResultSet cannot be forced deterministically without driver internals"
      },
      {
        "id": "prepared-binding",
        "says": "A PreparedStatement binds values to ? placeholders, so user input is data and can never change the SQL, where string concatenation allows SQL injection.",
        "basis": [
          "section:1. SQL Injection via String Concatenation",
          "example:45-java-persistence/README_10.7.1.md:2",
          "example:45-java-persistence/README_10.7.1.md:10"
        ],
        "exercise": "safe-search",
        "reason": null
      },
      {
        "id": "scrollable-result-set",
        "says": "A scrollable result set can move with last(), absolute() and previous(); a forward-only one, the default, only with next().",
        "basis": [
          "section:Interview Q&A Section",
          "example:45-java-persistence/README_10.7.1.md:20"
        ],
        "exercise": "row-position",
        "reason": null
      },
      {
        "id": "statement-kinds",
        "says": "Statement runs static SQL, PreparedStatement parameterised SQL whose plan the database can cache, and CallableStatement stored procedures.",
        "basis": [
          "section:Interview Q&A Section",
          "example:45-java-persistence/README_10.7.1.md:8"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "try-with-resources",
        "says": "Statements and result sets are closed with try-with-resources, so they are released even when an exception is thrown.",
        "basis": [
          "section:2. Resource Leaks",
          "example:45-java-persistence/README_10.7.1.md:3",
          "example:45-java-persistence/README_10.7.1.md:12"
        ],
        "exercise": "borrowed-connection",
        "reason": null
      },
      {
        "id": "update-count",
        "says": "executeUpdate returns the number of rows changed, which tells an UPDATE or DELETE whether its row existed.",
        "basis": [
          "tests:45-java-persistence/src/test/java/com/github/msorkhpar/claudejavatutor/javapersistence/JdbcOperationsTest.java"
        ],
        "exercise": "generated-keys",
