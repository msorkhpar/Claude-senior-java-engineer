    "aspects": [
      {
        "id": "bidirectional",
        "says": "Both sides of a bidirectional relationship are kept in step with a helper method on the owning side.",
        "basis": [
          "section:Edge Cases and Their Handling",
          "example:45-java-persistence/README_10.7.2.md:8"
        ],
        "exercise": "both-sides",
        "reason": null
      },
      {
        "id": "composite-keys",
        "says": "Composite keys use @IdClass or @EmbeddedId and must implement equals() and hashCode().",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": null,
        "reason": "equals and hashCode on value types are practised in the course's object-class module; the JPA annotations need a provider"
      },
      {
        "id": "dirty-checking",
        "says": "Dirty checking compares each managed entity with a snapshot at flush time and writes an UPDATE only for the changed ones, without an explicit update call.",
        "basis": [
          "section:Interview-specific Insights",
          "section:Key Points to Remember",
          "example:45-java-persistence/README_10.7.2.md:12"
        ],
        "exercise": "dirty-checking",
        "reason": null
      },
      {
        "id": "dto-not-entity",
        "says": "Entities are mapped to DTOs before leaving the service layer, so serialising them cannot trigger lazy loading or cycles.",
        "basis": [
          "section:4. Using Entity Objects as API Responses",
          "example:45-java-persistence/README_10.7.2.md:6"
        ],
        "exercise": null,
        "reason": "the harm is in a JSON serialiser walking entities, which the practice classpath does not have; lazy-loading covers the underlying LazyInitializationException"
      },
      {
        "id": "empty-collections",
        "says": "An uninitialised @OneToMany collection defaults to an empty list, not null.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "one-query-report",
        "reason": null
      },
      {
        "id": "entity-lifecycle",
        "says": "An entity is new, managed, detached or removed; changes to a detached entity are not tracked until merge() copies them into a managed instance.",
        "basis": [
          "section:2. Detached Entity Modifications Not Persisted",
          "example:45-java-persistence/README_10.7.2.md:4",
          "example:45-java-persistence/README_10.7.2.md:12"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "first-level-cache",
        "says": "The persistence context is a first-level cache: finding the same id twice in one EntityManager returns the same managed instance.",
        "basis": [
          "section:5. Ignoring the First-Level Cache",
          "example:45-java-persistence/README_10.7.2.md:7"
        ],
        "exercise": "identity-map",
        "reason": null
      },
      {
        "id": "identity-mismatch",
        "says": "Objects have identity through == and equals() while rows have it through the primary key, which an ORM reconciles.",
        "basis": [
          "section:The Object-Relational Impedance Mismatch"
        ],
        "exercise": "identity-map",
        "reason": null
      },
      {
        "id": "inheritance-strategies",
        "says": "SINGLE_TABLE maps a hierarchy to one table with a discriminator column and NULL subclass columns; JOINED and TABLE_PER_CLASS trade joins or unions for normalisation.",
        "basis": [
          "section:Interview Q&A Section",
          "example:45-java-persistence/README_10.7.2.md:16"
        ],
        "exercise": "single-table",
        "reason": null
      },
      {
        "id": "join-duplicates",
        "says": "A fetch join repeats each parent once per child, so the rows are grouped (DISTINCT) back into one parent each.",
        "basis": [
          "section:Interview Q&A Section"
        ],
        "exercise": "one-query-report",
        "reason": null
      },
      {
        "id": "jpa-vs-hibernate",
        "says": "JPA is a specification of interfaces and annotations; Hibernate, EclipseLink and OpenJPA implement it.",
        "basis": [
          "section:Interview Q&A Section",
          "example:45-java-persistence/README_10.7.2.md:10"
        ],
        "exercise": null,
        "reason": "a naming fact with no JPA provider on the practice classpath, so there is nothing to write against either"
      },
      {
        "id": "jpql",
        "says": "JPQL queries entities and their fields rather than tables and columns, with named parameters and constructor expressions.",
        "basis": [
          "section:JPQL and HQL",
          "example:45-java-persistence/README_10.7.2.md:1",
          "example:45-java-persistence/README_10.7.2.md:20"
        ],
        "exercise": null,
        "reason": "JPQL needs a JPA provider, which the practice classpath does not have; the practices write the SQL a provider would generate"
      },
      {
        "id": "lazy-init-exception",
        "says": "Touching a lazy collection that was never loaded after its EntityManager closed throws LazyInitializationException.",
        "basis": [
          "section:3. LazyInitializationException",
          "example:45-java-persistence/README_10.7.2.md:5"
        ],
        "exercise": "lazy-loading",
        "reason": null
      },
      {
        "id": "lazy-loading",
        "says": "A lazy association is fetched on first access; @OneToMany is LAZY and @ManyToOne EAGER by default.",
        "basis": [
          "section:Key Points to Remember"
        ],
        "exercise": "lazy-loading",
        "reason": null
      },
      {
        "id": "n-plus-one",
        "says": "The N+1 problem runs one query for the parents and one per parent for their children; JOIN FETCH loads them in one joined query.",
        "basis": [
          "section:1. The N+1 Select Problem",
          "example:45-java-persistence/README_10.7.2.md:3",
          "example:45-java-persistence/README_10.7.2.md:14"
        ],
        "exercise": "one-query-report",
        "reason": null
      },
      {
        "id": "optimistic-version",
        "says": "@Version enables optimistic locking, failing a stale write with OptimisticLockException.",
        "basis": [
          "section:Key Points to Remember"
        ],
        "exercise": null,
        "reason": "practised on the transactions page (10.7.3), in its optimistic-version practice"
      },
      {
        "id": "persist-vs-merge",
        "says": "persist() makes a new entity managed, while merge() returns a managed copy and leaves the object passed in detached.",
        "basis": [
          "section:Interview Q&A Section",
          "example:45-java-persistence/README_10.7.2.md:18"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "records-as-dtos",
        "says": "Records cannot be JPA entities, which need a no-arg constructor and mutable non-final state, but they suit DTO projections.",
        "basis": [
          "section:Relevant Java 21 Features",
          "example:45-java-persistence/README_10.7.2.md:2"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "tuning",
        "says": "@BatchSize, second-level caches, pagination, named queries and @Embeddable are the page's tuning options.",
        "basis": [
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": null,
        "reason": "provider annotations and caches with no JPA provider on the classpath to exercise them"
      }
