  "plan": {
    "plan_api": 2,
    "tier": "core",
    "count": 6,
    "aspects": [
      {
        "id": "choose-policy",
        "says": "The job decides the policy: SOURCE for compile-time notes, CLASS for bytecode tools, RUNTIME for frameworks that read annotations while the program runs.",
        "basis": [
          "section:Best Practices and Optimization Techniques",
          "example:42-annotations/README_10.4.3.md:2"
        ],
        "exercise": "choose-retention",
        "reason": null
      },
      {
        "id": "declared-vs-inherited",
        "says": "On a class getAnnotation() includes an @Inherited annotation from a superclass while getDeclaredAnnotation() does not, and method annotations are never inherited by overrides.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "example:42-annotations/README_10.4.3.md:3",
          "example:42-annotations/README_10.4.3.md:10",
          "example:42-annotations/README_10.4.3.md:11"
        ],
        "exercise": "method-annotations",
        "reason": null
      },
      {
        "id": "default-class",
        "says": "An annotation type without @Retention has the default policy CLASS, so reflection cannot see it.",
        "basis": [
          "section:Key Points to Remember",
          "example:42-annotations/README_10.4.3.md:1",
          "example:42-annotations/README_10.4.3.md:6",
          "example:42-annotations/README_10.4.3.md:7"
        ],
        "exercise": "retention-of",
        "reason": null
      },
      {
        "id": "local-variables",
        "says": "A declaration annotation on a local variable is never written to the class file, so no retention makes it visible to reflection.",
        "basis": [
          "section:Edge Cases and Their Handling",
          "example:42-annotations/README_10.4.3.md:12"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "nested-stages",
        "says": "Retention stages nest as SOURCE < CLASS < RUNTIME, and an annotation type's own @Retention can be read from its class object.",
        "basis": [
          "section:Key Points to Remember",
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "retention-of",
        "reason": null
      },
      {
        "id": "parameter-annotations",
        "says": "RUNTIME annotations on method parameters are read with getParameterAnnotations(), one array per parameter.",
        "basis": [
          "section:Edge Cases and Their Handling",
          "example:42-annotations/README_10.4.3.md:13"
        ],
        "exercise": "request-params",
        "reason": null
      },
      {
        "id": "processors-see-all",
        "says": "Annotation processors see annotations of every retention in the source they compile.",
        "basis": [
          "section:Key Points to Remember",
          "section:Relevant Java 21 Features"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "reflection-api",
        "says": "isAnnotationPresent, getAnnotation and getAnnotations read RUNTIME annotations on classes, methods and fields.",
        "basis": [
          "example:42-annotations/README_10.4.3.md:8",
          "example:42-annotations/README_10.4.3.md:9"
        ],
        "exercise": "choose-retention",
        "reason": null
      },
      {
        "id": "reflection-cost",
        "says": "For performance-sensitive code, SOURCE retention with an annotation processor avoids the cost of RUNTIME retention and reflection.",
        "basis": [
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": null,
        "reason": "speed cannot be graded deterministically; 10.4.4 practises both processing approaches"
      },
      {
        "id": "target-orthogonal",
        "says": "@Target decides where an annotation may be placed and is independent of @Retention.",
        "basis": [
          "section:Interview Q&A Section"
        ],
        "exercise": null,
        "reason": "the independence itself has nothing to grade; request-params and type-use-nonnull combine PARAMETER and TYPE_USE targets with RUNTIME retention"
      },
      {
        "id": "three-policies",
        "says": "SOURCE annotations are dropped by the compiler, CLASS annotations are written to the class file but not loaded for reflection, and RUNTIME annotations are also readable by reflection.",
        "basis": [
          "section:The Three Retention Policies",
          "example:42-annotations/README_10.4.3.md:4",
          "example:42-annotations/README_10.4.3.md:5"
        ],
        "exercise": "choose-retention",
        "reason": null
      },
      {
        "id": "type-use",
        "says": "A RUNTIME TYPE_USE annotation belongs to a type, including a type argument, and is read through AnnotatedType rather than the declaration.",
        "basis": [
          "example:42-annotations/README_10.4.3.md:14",
          "example:42-annotations/README_10.4.3.md:15"
        ],
        "exercise": "type-use-nonnull",
        "reason": null
      }
