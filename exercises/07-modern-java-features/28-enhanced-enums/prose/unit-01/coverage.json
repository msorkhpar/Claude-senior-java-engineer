  "plan": {
    "plan_api": 2,
    "tier": "core",
    "count": 5,
    "aspects": [
      {
        "id": "cannot-extend",
        "says": "An enum cannot extend a class or be extended, because it implicitly extends java.lang.Enum and is implicitly final or sealed.",
        "basis": [
          "section:Key Points to Remember"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "fixed-constant-set",
        "says": "An enum's constants are fixed at compile time, so values that must be added at run time need a registry instead.",
        "basis": [
          "section:Key Points to Remember",
          "section:Concept Explanation",
          "tests:28-enhanced-enums/src/test/java/com/github/msorkhpar/claudejavatutor/enhancedenums/TraditionalEnumLimitationsTest.java"
        ],
        "exercise": "registry",
        "reason": null
      },
      {
        "id": "init-thread-safety",
        "says": "Enum constants are initialized safely by the class loader, but mutable state inside a constant still needs synchronization.",
        "basis": [
          "section:Edge Cases and Their Handling",
          "section:Interview Q&A Section"
        ],
        "exercise": null,
        "reason": "the safe initialization is a JVM guarantee no test can make fail, and a data race on an unsynchronized counter cannot be forced deterministically; thread safety has its own modules (17-21)"
      },
      {
        "id": "interface-polymorphism",
        "says": "Several enums can implement one interface, so code written against the interface accepts constants of any of them.",
        "basis": [
          "section:Best Practices and Optimization Techniques",
          "section:Interview Q&A Section",
          "tests:28-enhanced-enums/src/test/java/com/github/msorkhpar/claudejavatutor/enhancedenums/TraditionalEnumLimitationsTest.java"
        ],
        "exercise": "severities",
        "reason": null
      },
      {
        "id": "lookup-map",
        "says": "A lookup by a non-name key is a static unmodifiable map built once from values(), returning an Optional, and duplicate keys are refused.",
        "basis": [
          "section:Interview Q&A Section",
          "tests:28-enhanced-enums/src/test/java/com/github/msorkhpar/claudejavatutor/enhancedenums/TraditionalEnumLimitationsTest.java"
        ],
        "exercise": "index-by-key",
        "reason": null
      },
      {
        "id": "no-generic-enum",
        "says": "An enum cannot declare a type parameter, so a value that differs in type per constant falls back to Object and unsafe casts.",
        "basis": [
          "section:Key Points to Remember",
          "section:Interview Q&A Section"
        ],
        "exercise": null,
        "reason": "the workarounds for this limitation are the subject of 7.2.2, whose class-token, type-safe container and sealed-record practices check them"
      },
      {
        "id": "no-runtime-instances",
        "says": "new on an enum is a compile error and reflective construction throws IllegalArgumentException.",
        "basis": [
          "section:Key Points to Remember"
        ],
        "exercise": null,
        "reason": "incidental detail, not practised: a compile-time rule, and the registry practice covers what to do instead"
      },
      {
        "id": "persist-by-name",
        "says": "An enum is persisted by name() or a stable code, because stored ordinals point at different constants once constants are added or reordered.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them"
        ],
        "exercise": "store-by-name",
        "reason": null
      },
      {
        "id": "safe-value-of",
        "says": "Enum.valueOf throws for an unknown name and for null, so a safe lookup wraps it and returns an Optional.",
        "basis": [
          "section:Best Practices and Optimization Techniques",
          "section:Edge Cases and Their Handling",
          "tests:28-enhanced-enums/src/test/java/com/github/msorkhpar/claudejavatutor/enhancedenums/TraditionalEnumLimitationsTest.java"
        ],
        "exercise": "store-by-name",
        "reason": null
      },
      {
        "id": "same-field-values",
        "says": "Two constants with identical constructor arguments remain distinct instances.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": null,
        "reason": "incidental detail, not practised"
      },
      {
        "id": "sealed-alternative",
        "says": "A sealed interface with records replaces an enum when constants need different generic types or different fields.",
        "basis": [
          "section:Relevant Java 21 Features",
          "section:Interview Q&A Section"
        ],
        "exercise": null,
        "reason": "the sealed-interface pattern is practised on 7.2.2, and sealed types have their own module (10)"
      },
      {
        "id": "serialized-by-name",
        "says": "Only an enum constant's name is serialized; the receiving JVM supplies its own constant with its own field values.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "section:Interview Q&A Section"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "single-type-enumset",
        "says": "EnumSet and EnumMap hold constants of a single enum type only.",
        "basis": [
          "section:Key Points to Remember"
        ],
        "exercise": null,
        "reason": "a compile-time restriction no test can observe; EnumSet and EnumMap are practised on 7.2.5"
      }
    ],
