    "aspects": [
      {
        "id": "class-token-cast",
        "says": "An enum that stores a Class token keeps enum features and checks types at run time with Class.cast, instead of an unchecked (T) cast that fails later.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "section:Interview Q&A Section",
          "tests:28-enhanced-enums/src/test/java/com/github/msorkhpar/claudejavatutor/enhancedenums/GenericEnumPatternsTest.java"
        ],
        "exercise": "class-token",
        "reason": null
      },
      {
        "id": "exhaustive-sealed-switch",
        "says": "Pattern matching for switch is exhaustive over a sealed interface, as it is over an enum.",
        "basis": [
          "section:Relevant Java 21 Features"
        ],
        "exercise": null,
        "reason": "exhaustiveness is checked by the compiler, so no test can observe it; the setting-parser reference uses such a switch, and pattern matching has its own module (05)"
      },
      {
        "id": "heterogeneous-container",
        "says": "A type-safe heterogeneous container stores values as Object and casts them back with each key's Class token, so callers never cast.",
        "basis": [
          "section:Interview Q&A Section",
          "tests:28-enhanced-enums/src/test/java/com/github/msorkhpar/claudejavatutor/enhancedenums/GenericEnumPatternsTest.java"
        ],
        "exercise": "typed-container",
        "reason": null
      },
      {
        "id": "mutable-members",
        "says": "Classes instead of records in a sealed hierarchy lose the immutability guarantee.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them"
        ],
        "exercise": null,
        "reason": "incidental detail, not practised; records have their own module (09)"
      },
      {
        "id": "no-type-parameters",
        "says": "An enum declaration cannot take type parameters; this is a language-design decision rather than erasure, and JEP 301, which proposed generic enums, was withdrawn.",
        "basis": [
          "section:Concept Explanation",
          "section:Key Points to Remember",
          "section:Interview Q&A Section"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "pattern-trade-offs",
        "says": "Each workaround trades something: the Class-token enum keeps EnumSet and switch but checks only at run time, while sealed records and static instances type fully but lose EnumSet and EnumMap.",
        "basis": [
          "section:Key Points to Remember",
          "section:Interview Q&A Section"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "record-equality",
        "says": "Record \"constants\" are equal by value but not identical, unlike enum constants, so they are compared with equals.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "typed-container",
        "reason": null
      },
      {
        "id": "seal-the-interface",
        "says": "An unsealed setting interface can be implemented by any class, so the set of constants is not closed.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them"
        ],
        "exercise": null,
        "reason": "a compile-time property that no test can observe; sealed types have their own module (10)"
      },
      {
        "id": "sealed-records",
        "says": "A sealed generic interface whose permitted records play the constants gives each constant its own type argument, so values come back typed without casts.",
        "basis": [
          "section:Best Practices and Optimization Techniques",
          "section:Interview Q&A Section",
          "tests:28-enhanced-enums/src/test/java/com/github/msorkhpar/claudejavatutor/enhancedenums/GenericEnumPatternsTest.java"
        ],
        "exercise": "setting-parser",
        "reason": null
      },
      {
        "id": "sealed-values",
        "says": "A static values() method on the sealed interface stands in for Enum.values().",
        "basis": [
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": "setting-parser",
        "reason": null
      },
      {
        "id": "static-final-instances",
        "says": "A generic class with static final instances and a private constructor gives full generic typing, even for parameterized types, but has no built-in values() or lookup.",
        "basis": [
          "section:Interview Q&A Section",
          "tests:28-enhanced-enums/src/test/java/com/github/msorkhpar/claudejavatutor/enhancedenums/GenericEnumPatternsTest.java"
        ],
        "exercise": "static-instances",
        "reason": null
      },
      {
        "id": "supplier-pattern",
        "says": "Storing a Supplier per constant makes a new value on every call, for defaults that must not be shared.",
        "basis": [
          "section:Concept Explanation",
          "tests:28-enhanced-enums/src/test/java/com/github/msorkhpar/claudejavatutor/enhancedenums/GenericEnumPatternsTest.java"
        ],
        "exercise": "lazy-defaults",
        "reason": null
      },
      {
        "id": "type-token-parameterized",
        "says": "A Class token cannot express a parameterized type such as List<String>, so libraries use a TypeToken or TypeReference.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": null,
        "reason": "incidental detail, not practised; the static-instances practice shows a parameterized key that needs no Class token"
      }
