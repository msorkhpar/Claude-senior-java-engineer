      "kind": "main",
      "says": "With the closing delimiter on the last content line, the smallest indentation of the lines is removed and no newline is added."
    },
    {
      "id": "practice.TextBlockValueTest#closingOnItsOwnLineAddsANewline",
      "kind": "edge",
      "says": "A closing delimiter on its own line ends the value with a newline."
    },
    {
      "id": "practice.TextBlockValueTest#closingLeftOfTheContentKeepsIndentation",
      "kind": "edge",
      "says": "A closing delimiter to the left of the content counts in the smallest indentation, so the content keeps the difference; at column 0 it keeps all of it."
    },
    {
      "id": "practice.TextBlockValueTest#closingRightOfTheContentChangesNothing",
      "kind": "edge",
      "says": "A closing delimiter to the right of the content does not raise the removed indentation; it only takes part in a minimum."
    },
    {
      "id": "practice.TextBlockValueTest#anEmptyBlockIsEmpty",
      "kind": "edge",
      "says": "A block with no content line, only the closing delimiter, is the empty string, with no newline."
    },
    {
      "id": "practice.TextBlockValueTest#windowsLineEndingsGiveTheSameValue",
      "kind": "edge",
      "says": "Source saved with \\r\\n or \\r line endings gives the same value, with \\n between lines."
    }
