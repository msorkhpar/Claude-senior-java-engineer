        "reason": null
      },
      {
        "id": "other-languages",
        "says": "Kotlin, Groovy and Scala had multi-line strings first, and unlike Kotlin's raw strings Java's text blocks still process escapes.",
        "basis": [
          "section:Interview Q&A Section"
        ],
        "exercise": null,
        "reason": "background comparison with other languages, nothing to practise in Java"
      },
      {
        "id": "reading-escapes",
        "says": "Reading a literal means decoding its escapes: \\\\ is one escape standing for one backslash, and the letter after it is plain text.",
        "basis": [
          "section:Interview Q&A Section"
        ],
        "exercise": "escapes",
        "reason": null
      },
      {
        "id": "regex-double-escape",
        "says": "A regex backslash is doubled again in a Java literal, so the regex \\d+ is written \"\\\\d+\", and a Windows path doubles every backslash.",
        "basis": [
          "section:Interview Q&A Section",
          "section:Common Pitfalls and How to Avoid Them"
        ],
        "exercise": "literal",
        "reason": null
      },
      {
        "id": "runtime-equivalence",
        "says": "A text block and a traditional literal with the same characters are the same interned constant, so there is no run-time cost difference.",
        "basis": [
          "section:Interview Q&A Section"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "sql-quote-doubling",
        "says": "A quote inside SQL text is doubled ('O''Brien'), a separate escaping system from Java's, which needs no escape for a single quote.",
        "basis": [
          "section:Interview Q&A Section"
        ],
        "exercise": "sqlQuery",
        "reason": null
      },
      {
        "id": "when-traditional",
        "says": "Short single-line strings stay traditional literals; text blocks are for multi-line or escape-heavy content.",
        "basis": [
          "section:Interview Q&A Section"
        ],
        "exercise": null,
        "reason": "a style judgement with no observable result: a well-chosen literal and a text block with the same value are the same string, so no test can tell them apart"
      }
