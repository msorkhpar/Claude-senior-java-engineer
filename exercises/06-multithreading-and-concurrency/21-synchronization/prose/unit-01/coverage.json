  "plan": {
    "plan_api": 2,
    "tier": "core",
    "count": 7,
    "aspects": [
      {
        "id": "alien-calls",
        "says": "Calling unknown code such as a listener while holding a lock risks deadlock, so the state is updated under the lock and the listener is called after release.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them"
        ],
        "exercise": "listeners",
        "reason": null
      },
      {
        "id": "deadlock",
        "says": "Two threads that take the same two locks in opposite orders can each hold one and wait forever for the other.",
        "basis": [
          "section:Deadlocks and Starvation",
          "tests:21-synchronization/src/test/java/com/github/msorkhpar/claudejavatutor/synchronization/DeadlockPreventionTest.java"
        ],
        "exercise": "transfer",
        "reason": null
      },
      {
        "id": "deadlock-conditions",
        "says": "A deadlock needs mutual exclusion, hold and wait, no preemption and circular wait, all at once.",
        "basis": [
          "section:Key Points to Remember"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "deadlock-detection",
        "says": "Thread dumps and ThreadMXBean.findDeadlockedThreads() detect a deadlock after it happens.",
        "basis": [
          "section:Interview Q&A Section"
        ],
        "exercise": null,
        "reason": "a diagnostic tool rather than a way to write correct code; the transfer practice's test detects the deadlock its wrong solution causes"
      },
      {
        "id": "interrupt-not-swallowed",
        "says": "An InterruptedException must not be swallowed: it is passed on, or the interrupt flag is restored.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them"
        ],
        "exercise": "buffer",
        "reason": null
      },
      {
        "id": "livelock",
        "says": "In a livelock the threads keep running and keep reacting to each other in step, yet none makes progress.",
        "basis": [
          "section:Deadlocks and Starvation"
        ],
        "exercise": "walkers",
        "reason": null
      },
      {
        "id": "lock-ordering",
        "says": "Taking locks in one global order, such as by account id, removes the circular wait and so the deadlock.",
        "basis": [
          "section:Avoiding Deadlocks"
        ],
        "exercise": "transfer",
        "reason": null
      },
      {
        "id": "mutual-exclusion",
        "says": "Only one thread at a time holds an object's intrinsic lock, so a second synchronized update waits for the first.",
        "basis": [
          "section:Intrinsic Locks (Monitors)",
          "tests:21-synchronization/src/test/java/com/github/msorkhpar/claudejavatutor/synchronization/SynchronizedBlocksTest.java"
        ],
        "exercise": "update",
        "reason": null
      },
      {
        "id": "narrow-critical-section",
        "says": "A lock is held only as long as the shared state needs it, and slow work stays outside the critical section.",
        "basis": [
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": "listeners",
        "reason": null
      },
      {
        "id": "null-lock",
        "says": "Synchronizing on null throws NullPointerException.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": null,
        "reason": "a one-line runtime rule with nothing further to practise; every practice on this page locks a non-null object"
      },
      {
        "id": "private-lock",
        "says": "A private final lock object keeps outside code from taking the lock, which a synchronized method on this cannot.",
        "basis": [
          "section:Key Points to Remember",
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": "update",
        "reason": null
      },
      {
        "id": "random-backoff",
        "says": "Randomized backoff breaks the symmetry that keeps a livelock going, so the threads get through.",
        "basis": [
          "section:Deadlocks and Starvation"
        ],
        "exercise": "walkers",
        "reason": null
      },
      {
        "id": "reentrancy",
        "says": "Intrinsic locks are reentrant: the holder can take the lock again, and a hold count says when the lock is free.",
        "basis": [
          "section:Intrinsic Locks (Monitors)",
          "section:Interview-specific Insights"
        ],
        "exercise": "mutex",
        "reason": null
      },
      {
        "id": "release-on-exception",
        "says": "The intrinsic lock is released when a synchronized block exits, even by an exception.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "update",
        "reason": null
      },
      {
        "id": "shared-lock-object",
        "says": "A lock protects shared state only when every thread uses the same lock object; synchronized (new Object()) protects nothing.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them"
        ],
        "exercise": "update",
        "reason": null
      },
      {
        "id": "starvation-fairness",
        "says": "A thread can starve without any deadlock, and a fair ReentrantLock grants the lock to the longest-waiting thread.",
        "basis": [
          "section:Deadlocks and Starvation"
        ],
        "exercise": null,
        "reason": "lock fairness belongs to ReentrantLock, the subject of the locks and semaphores module (22); and no deterministic test can show an unfair lock starving a thread"
      },
      {
        "id": "static-vs-instance",
        "says": "A static synchronized method locks the Class object and an instance one locks this, so the two can run at the same time.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "trylock-timeout",
        "says": "tryLock with a timeout lets a thread give up instead of waiting forever for a lock.",
        "basis": [
          "section:Avoiding Deadlocks"
        ],
        "exercise": null,
        "reason": "tryLock belongs to ReentrantLock, the subject of the locks and semaphores module (22); this page's deadlock practice uses lock ordering, which the page calls the most reliable strategy"
      },
      {
        "id": "virtual-thread-pinning",
        "says": "In Java 21 a virtual thread that blocks inside synchronized pins its carrier thread.",
        "basis": [
          "section:Relevant Java 21 Features"
        ],
        "exercise": null,
        "reason": "a scheduling property of the runtime that no graded test can observe; virtual threads are the subject of module 26"
      },
      {
        "id": "wait-notify",
        "says": "wait() releases the monitor and is called in a loop over its condition; notifyAll() wakes the waiters when the state changes.",
        "basis": [
          "section:Interview Q&A Section"
        ],
        "exercise": "buffer",
        "reason": null
      }
    ],
