    "aspects": [
      {
        "id": "bounded-join",
        "says": "join(millis) bounds the wait, after which isAlive() tells whether to interrupt the worker.",
        "basis": [
          "section:`join()` — Waiting for a Thread to Complete",
          "example:20-thread-basics/README_6.1.2.md:11",
          "example:20-thread-basics/README_6.1.2.md:18"
        ],
        "exercise": "deadline",
        "reason": null
      },
      {
        "id": "higher-level-tools",
        "says": "In production, executors, CompletableFuture, latches and virtual-thread executors replace bare threads and chained joins.",
        "basis": [
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": null,
        "reason": "named as advice only; executors, CompletableFuture and virtual-thread executors are the subjects of modules 23 and 26"
      },
      {
        "id": "join-before-reading",
        "says": "A worker's result is read only after join() returns; reading it earlier is a race.",
        "basis": [
          "example:20-thread-basics/README_6.1.2.md:8",
          "tests:20-thread-basics/src/test/java/com/github/msorkhpar/claudejavatutor/threadbasics/ThreadStartingTest.java"
        ],
        "exercise": "fanout",
        "reason": null
      },
      {
        "id": "join-unstarted-and-zero",
        "says": "join() on a thread that was never started returns at once, and join(0) waits forever.",
        "basis": [
          "section:Edge Cases and Their Handling",
          "tests:20-thread-basics/src/test/java/com/github/msorkhpar/claudejavatutor/threadbasics/ThreadStartingTest.java"
        ],
        "exercise": "deadline",
        "reason": null
      },
      {
        "id": "no-immediate-join",
        "says": "Joining each thread straight after starting it makes the work sequential, so every worker is started before any is joined.",
        "basis": [
          "example:20-thread-basics/README_6.1.2.md:9"
        ],
        "exercise": "fanout",
        "reason": null
      },
      {
        "id": "sleep-keeps-monitors",
        "says": "Thread.sleep() pauses the current thread and gives up the CPU but keeps every monitor it holds.",
        "basis": [
          "section:Key Points to Remember"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "start-join-happens-before",
        "says": "join() makes every write of the joined thread visible to the joiner, as start() does for the parent's earlier writes, with no volatile or locks.",
        "basis": [
          "example:20-thread-basics/README_6.1.2.md:24"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "start-non-blocking",
        "says": "start() returns at once and runs run() on the new thread, while calling run() directly is an ordinary call on the caller.",
        "basis": [
          "section:Concept Explanation",
          "example:20-thread-basics/README_6.1.2.md:6"
        ],
        "exercise": null,
        "reason": "practised on 6.1.1 by 'Start a task on its own named thread', whose edge cases are exactly these two"
      },
      {
        "id": "start-only-when-new",
        "says": "start() is legal only on a NEW thread; a running or finished thread throws IllegalThreadStateException, so a new Thread instance is the way to run the work again.",
        "basis": [
          "section:Key Points to Remember",
          "example:20-thread-basics/README_6.1.2.md:22",
          "tests:20-thread-basics/src/test/java/com/github/msorkhpar/claudejavatutor/threadbasics/ThreadStartingTest.java"
        ],
        "exercise": "keep",
        "reason": null
      },
      {
        "id": "uncaught-handler",
        "says": "An exception thrown from run() ends that thread and goes to its UncaughtExceptionHandler, never to the thread that called start().",
        "basis": [
          "section:Edge Cases and Their Handling",
          "example:20-thread-basics/README_6.1.2.md:20",
          "tests:20-thread-basics/src/test/java/com/github/msorkhpar/claudejavatutor/threadbasics/ThreadStartingTest.java"
        ],
        "exercise": "crash",
        "reason": null
