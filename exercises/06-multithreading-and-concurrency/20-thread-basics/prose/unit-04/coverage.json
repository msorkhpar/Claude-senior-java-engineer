  "plan": {
    "plan_api": 2,
    "tier": "core",
    "count": 5,
    "aspects": [
      {
        "id": "blocked-is-monitor",
        "says": "BLOCKED is only for waiting on a synchronized monitor; a thread waiting for a ReentrantLock is parked and shows WAITING.",
        "basis": [
          "section:Key Points to Remember"
        ],
        "exercise": "states",
        "reason": null
      },
      {
        "id": "dump-diagnosis",
        "says": "In a thread dump, many BLOCKED threads on one monitor mean contention, and a cycle of BLOCKED threads means deadlock.",
        "basis": [
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": "dump",
        "reason": null
      },
      {
        "id": "getstate-snapshot",
        "says": "getState() is a snapshot, so synchronization uses join() or a latch, never a state check.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them"
        ],
        "exercise": null,
        "reason": "a race between a state check and the thread's next move cannot be made to go wrong on every run, so no test can grade it; the page's practices observe states only under a bound"
      },
      {
        "id": "one-way-ends",
        "says": "NEW is left once by start(), and TERMINATED is permanent.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "transitions",
        "reason": null
      },
      {
        "id": "park-unpark",
        "says": "LockSupport.park and unpark give permit-based waiting without a monitor.",
        "basis": [
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": null,
        "reason": "named as advice; the lock machinery built on it is the subject of module 22 (locks and semaphores)"
      },
      {
        "id": "runnable-includes-ready",
        "says": "RUNNABLE covers both running and ready to run: Java has no RUNNING state.",
        "basis": [
          "section:Key Points to Remember"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "six-states",
        "says": "A thread is in exactly one of six Thread.State values, each entered by a named trigger.",
        "basis": [
          "section:What Triggers Each State Transition",
          "tests:20-thread-basics/src/test/java/com/github/msorkhpar/claudejavatutor/threadbasics/ThreadLifecycleTest.java"
        ],
        "exercise": "states",
        "reason": null
      },
      {
        "id": "spin-hints",
        "says": "yield() and onSpinWait() are scheduler hints: the thread stays RUNNABLE.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": null,
        "reason": "a hint with no observable effect beyond staying RUNNABLE, which the quiz's RUNNABLE question already asks about"
      },
      {
        "id": "start-once",
        "says": "Calling start() twice throws IllegalThreadStateException.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": null,
        "reason": "practised on 6.1.2 by 'Keep a job running without starting a thread twice'"
      },
      {
        "id": "terminated-after-exception",
        "says": "A thread whose run() throws is TERMINATED all the same.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": null,
        "reason": "practised on 6.1.2 by 'Report what a worker thread threw', whose worker ends by throwing"
      },
      {
        "id": "timed-vs-untimed",
        "says": "WAITING and TIMED_WAITING differ only in whether the wait has a timeout.",
        "basis": [
          "section:What Triggers Each State Transition"
        ],
        "exercise": "states",
        "reason": null
      },
      {
        "id": "tooling",
        "says": "jstack, jcmd, JMX and repeated dumps are how states are read in production.",
        "basis": [
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": null,
        "reason": "operational tooling outside a practice's JVM; the dump practice reads the states such a dump reports"
      },
      {
        "id": "valid-transitions",
        "says": "A thread must be RUNNABLE to start waiting, so BLOCKED never goes straight to WAITING, while a notified waiter may go straight to BLOCKED.",
        "basis": [
          "section:Interview Q&A Section"
        ],
        "exercise": "transitions",
        "reason": null
      },
      {
        "id": "virtual-same-states",
        "says": "Virtual threads go through the same six states, but waiting unmounts them from their carrier thread.",
        "basis": [
          "section:Relevant Java 21 Features"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "wait-in-loop",
        "says": "Object.wait() can wake spuriously, so it is called in a loop that re-checks the condition.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "gate",
        "reason": null
      },
      {
        "id": "wait-releases",
        "says": "A thread in wait() is WAITING and has released the monitor, unlike a BLOCKED thread that never had it.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them"
        ],
        "exercise": "gate",
        "reason": null
      }
