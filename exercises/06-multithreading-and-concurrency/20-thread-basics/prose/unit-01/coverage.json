      },
      {
        "id": "callable",
        "says": "A Callable returns a value and may throw checked exceptions; its Future's get() reports a failure as an ExecutionException wrapping the cause.",
        "basis": [
          "example:20-thread-basics/README_6.1.1.md:24",
          "section:Interview-specific Insights",
