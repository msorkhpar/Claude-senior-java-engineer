    "aspects": [
      {
        "id": "acquire-n-atomic",
        "says": "acquire(n) and tryAcquire(n) take all n permits together or none, so a waiter never holds a partial set that others need.",
        "basis": [
          "section:Edge Cases and Their Handling",
          "example:22-locks-semaphores/README_6.3.2.md:17",
          "tests:22-locks-semaphores/src/test/java/com/github/msorkhpar/claudejavatutor/lockssemaphores/SemaphoreUsageTest.java"
        ],
        "exercise": "leases",
        "reason": null
      },
      {
        "id": "check-then-act",
        "says": "Checking availablePermits() and then calling acquire() is a race; tryAcquire() checks and takes in one atomic step.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "example:22-locks-semaphores/README_6.3.2.md:6"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "counting-permits",
        "says": "A Semaphore(N) lets at most N holders at once: acquire() takes a permit and waits while none is free, release() returns one.",
        "basis": [
          "section:Concept Explanation",
          "section:Core Methods",
          "example:22-locks-semaphores/README_6.3.2.md:9",
          "tests:22-locks-semaphores/src/test/java/com/github/msorkhpar/claudejavatutor/lockssemaphores/SemaphoreUsageTest.java"
        ],
        "exercise": "pool",
        "reason": null
      },
      {
        "id": "drain-permits",
        "says": "drainPermits() atomically takes every free permit and returns how many it took.",
        "basis": [
          "section:Core Methods"
        ],
        "exercise": null,
        "reason": "a minor utility method with nothing further to practise"
      },
      {
        "id": "fair-semaphore",
        "says": "new Semaphore(n, true) grants permits to waiters in arrival order, at a cost in throughput.",
        "basis": [
          "section:Java's Semaphore Class"
        ],
        "exercise": null,
        "reason": "arrival order under contention cannot be observed deterministically; the fairness trade-off is asked in the quiz of 6.3.1"
      },
      {
        "id": "interruption-propagates",
        "says": "An InterruptedException from acquire is passed on or the interrupt flag restored, never swallowed, and the interrupted acquire holds nothing.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "example:22-locks-semaphores/README_6.3.2.md:7"
        ],
        "exercise": "leases",
        "reason": null
      },
      {
        "id": "max-permit-overflow",
        "says": "A release that would push the count past Integer.MAX_VALUE throws an Error instead of overflowing.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": null,
        "reason": "a pathological limit that correct code never reaches"
      },
      {
        "id": "no-owner-vs-lock",
        "says": "Unlike a ReentrantLock, a semaphore tracks no owner: a binary semaphore can be released by a thread that never acquired it.",
        "basis": [
          "section:Key Difference: Semaphore vs. Lock",
          "example:22-locks-semaphores/README_6.3.2.md:4",
          "example:22-locks-semaphores/README_6.3.2.md:11"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "not-reentrant",
        "says": "A semaphore is not reentrant: a thread that acquires twice consumes two permits and can block itself.",
        "basis": [
          "example:22-locks-semaphores/README_6.3.2.md:5"
        ],
        "exercise": null,
        "reason": "showing it takes a thread that deadlocks itself, which adds nothing beyond the permit counting the pool practice checks; the quiz contrasts semaphore and lock through ownership"
      },
      {
        "id": "permit-inflation",
        "says": "A semaphore enforces no upper bound, so releasing more than was acquired inflates the count; application code must guard it.",
        "basis": [
          "section:Bounded vs. Unbounded Semaphores",
          "example:22-locks-semaphores/README_6.3.2.md:3",
          "example:22-locks-semaphores/README_6.3.2.md:19"
        ],
        "exercise": "pool",
        "reason": null
      },
      {
        "id": "reject-without-blocking",
        "says": "For rate limiting, tryAcquire() without a timeout rejects excess work at once instead of queueing it.",
        "basis": [
          "section:Best Practices and Optimization Techniques",
          "example:22-locks-semaphores/README_6.3.2.md:13"
        ],
        "exercise": "bulkhead",
        "reason": null
      },
      {
        "id": "release-any-thread",
        "says": "Any thread may release a permit, and a release that comes before any acquire is kept, which makes a semaphore a signal between threads.",
        "basis": [
          "section:Key Points to Remember",
          "example:22-locks-semaphores/README_6.3.2.md:15",
          "example:22-locks-semaphores/README_6.3.2.md:19",
          "tests:22-locks-semaphores/src/test/java/com/github/msorkhpar/claudejavatutor/lockssemaphores/SemaphoreUsageTest.java"
        ],
        "exercise": "rendezvous",
        "reason": null
      },
      {
        "id": "release-in-finally",
        "says": "A permit is released in a finally block, so an exception in the guarded work cannot leak it.",
        "basis": [
          "section:Best Practices and Optimization Techniques",
          "example:22-locks-semaphores/README_6.3.2.md:2"
        ],
        "exercise": "bulkhead",
        "reason": null
      },
      {
        "id": "release-only-acquired",
        "says": "A call that failed to get a permit must not release one, or the limit grows with every rejection.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them"
        ],
        "exercise": "bulkhead",
        "reason": null
      },
      {
        "id": "time-window-rate-limit",
        "says": "A time-window rate limiter replenishes permits on a schedule, like a token bucket.",
        "basis": [
          "example:22-locks-semaphores/README_6.3.2.md:13"
        ],
        "exercise": null,
        "reason": "a clock-driven design that no test can check without timing; the bulkhead practice covers the non-blocking rejection it relies on"
      },
      {
        "id": "timed-try-acquire",
        "says": "tryAcquire(timeout, unit) waits at most the timeout for a permit and returns false when none came.",
        "basis": [
          "section:Core Methods",
          "tests:22-locks-semaphores/src/test/java/com/github/msorkhpar/claudejavatutor/lockssemaphores/SemaphoreUsageTest.java"
        ],
        "exercise": "pool",
        "reason": null
      },
      {
        "id": "virtual-threads",
        "says": "A virtual thread that waits in Semaphore.acquire() parks and frees its carrier, so semaphores scale with virtual threads.",
        "basis": [
          "section:Relevant Java 21 Features"
        ],
        "exercise": null,
        "reason": "a scheduling property of the runtime that no deterministic test can observe; virtual threads are the subject of module 26"
      },
      {
        "id": "zero-or-negative-start",
        "says": "A semaphore may start at zero or below, so acquirers wait until enough releases have brought the count above zero.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "rendezvous",
        "reason": null
      }
