  "plan": {
    "plan_api": 2,
    "tier": "core",
    "count": 6,
    "aspects": [
      {
        "id": "await-in-loop",
        "says": "await() is called in a loop over its condition because a thread can wake without its state holding (a spurious wakeup).",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "example:22-locks-semaphores/README_6.3.1.md:9"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "check-try-lock-result",
        "says": "The boolean from tryLock() must be checked; entering the critical section without it runs unguarded and ends in IllegalMonitorStateException.",
        "basis": [
          "example:22-locks-semaphores/README_6.3.1.md:7"
        ],
        "exercise": "counter",
        "reason": null
      },
      {
        "id": "fairness-trade-off",
        "says": "A fair lock hands the lock to the longest waiter and prevents starvation, at a cost in throughput; the default non-fair lock lets arrivals barge.",
        "basis": [
          "section:ReentrantLock Class",
          "example:22-locks-semaphores/README_6.3.1.md:18"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "hold-count-overflow",
        "says": "Re-entering more than Integer.MAX_VALUE times throws an Error instead of overflowing the hold count.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": null,
        "reason": "a pathological limit the page calls a design error; nothing a reader writes should reach it"
      },
      {
        "id": "illegal-monitor-state",
        "says": "unlock() by a thread that does not hold the lock, or await() without holding it, throws IllegalMonitorStateException.",
        "basis": [
          "example:22-locks-semaphores/README_6.3.1.md:6",
          "example:22-locks-semaphores/README_6.3.1.md:8"
        ],
        "exercise": null,
        "reason": "a runtime rule of the API with nothing to write; the counter practice's ignored-tryLock mistake ends in exactly this exception"
      },
      {
        "id": "lock-interruptibly",
        "says": "lockInterruptibly() lets a thread waiting for a lock be cancelled by interrupt: it throws InterruptedException and does not get the lock.",
        "basis": [
          "section:Key Points to Remember",
          "section:Edge Cases and Their Handling",
          "tests:22-locks-semaphores/src/test/java/com/github/msorkhpar/claudejavatutor/lockssemaphores/ReentrantLockBasicsTest.java"
        ],
        "exercise": "interruptible",
        "reason": null
      },
      {
        "id": "lock-vs-synchronized",
        "says": "ReentrantLock is chosen over synchronized when timeouts, interruptible waits, several conditions or fairness are needed; synchronized suits short simple sections.",
        "basis": [
          "section:Interview Q&A Section",
          "example:22-locks-semaphores/README_6.3.1.md:11",
          "example:22-locks-semaphores/README_6.3.1.md:12"
        ],
        "exercise": null,
        "reason": "a design choice that every practice on this page applies, each needing one feature synchronized lacks (a timeout, an interruptible wait, two conditions, shared reads)"
      },
      {
        "id": "multiple-conditions",
        "says": "One lock can create several Conditions, so producers and consumers wait in separate sets and each change wakes the side that can proceed.",
        "basis": [
          "section:Condition Objects",
          "example:22-locks-semaphores/README_6.3.1.md:16",
          "tests:22-locks-semaphores/src/test/java/com/github/msorkhpar/claudejavatutor/lockssemaphores/ConditionUsageTest.java"
        ],
        "exercise": "queue",
        "reason": null
      },
      {
        "id": "no-upgrade",
        "says": "A thread holding the read lock cannot upgrade to the write lock; it must release the read lock before asking for the write lock.",
        "basis": [
          "tests:22-locks-semaphores/src/test/java/com/github/msorkhpar/claudejavatutor/lockssemaphores/ReadWriteLockUsageTest.java"
        ],
        "exercise": "cache",
        "reason": null
      },
      {
        "id": "owner-death",
        "says": "A ReentrantLock held by a thread that terminates is never released, unlike a synchronized monitor.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": null,
        "reason": "a fact about an abandoned lock rather than a technique to practise; the finally rule in the interruptible practice is what prevents it"
      },
      {
        "id": "queue-diagnostics",
        "says": "hasQueuedThreads() and getQueueLength() report threads waiting for the lock, which isLocked() does not.",
        "basis": [
          "section:Key Points to Remember",
          "example:22-locks-semaphores/README_6.3.1.md:23"
        ],
        "exercise": "counter",
        "reason": null
      },
      {
        "id": "read-write-lock",
        "says": "A ReentrantReadWriteLock lets many readers hold the read lock together while the write lock is exclusive of readers and writers.",
        "basis": [
          "section:Best Practices and Optimization Techniques",
          "tests:22-locks-semaphores/src/test/java/com/github/msorkhpar/claudejavatutor/lockssemaphores/ReadWriteLockUsageTest.java"
        ],
        "exercise": "cache",
        "reason": null
      },
      {
        "id": "recheck-after-write-lock",
        "says": "After trading the read lock for the write lock, the value is looked up again, since another thread may have stored it in between.",
        "basis": [
          "tests:22-locks-semaphores/src/test/java/com/github/msorkhpar/claudejavatutor/lockssemaphores/ReadWriteLockUsageTest.java"
        ],
        "exercise": null,
        "reason": "the double load only happens when two misses meet in the gap between releasing the read lock and taking the write lock, which the API gives a test no way to force; the cache statement keeps it as advice"
      },
      {
        "id": "reentrancy-hold-count",
        "says": "A thread that holds a ReentrantLock can lock it again; the hold count must return to zero, one unlock per lock, before another thread can take it.",
        "basis": [
          "section:ReentrantLock Class",
          "example:22-locks-semaphores/README_6.3.1.md:14"
        ],
        "exercise": "audit",
        "reason": null
      },
      {
        "id": "signal-right-condition",
        "says": "Signalling the wrong Condition wakes nobody who can proceed, leaving the right waiter parked.",
        "basis": [
          "example:22-locks-semaphores/README_6.3.1.md:10"
        ],
        "exercise": "queue",
        "reason": null
      },
      {
        "id": "timed-await",
        "says": "awaitNanos returns the time left, so a timed wait loops until its state holds or the time is used up and then reports failure.",
        "basis": [
          "section:Edge Cases and Their Handling",
          "tests:22-locks-semaphores/src/test/java/com/github/msorkhpar/claudejavatutor/lockssemaphores/ConditionUsageTest.java"
        ],
        "exercise": "queue",
        "reason": null
      },
      {
        "id": "timed-try-lock",
        "says": "tryLock(time, unit) waits at most the timeout, succeeds if the lock is released in time and gives up with false otherwise.",
        "basis": [
          "section:Interview Q&A Section",
          "example:22-locks-semaphores/README_6.3.1.md:23",
          "tests:22-locks-semaphores/src/test/java/com/github/msorkhpar/claudejavatutor/lockssemaphores/ReentrantLockBasicsTest.java"
        ],
        "exercise": "counter",
        "reason": null
      },
      {
        "id": "try-lock",
        "says": "tryLock() takes the lock only if it is free right now and returns whether it did, never waiting.",
        "basis": [
          "section:The Lock Interface",
          "example:22-locks-semaphores/README_6.3.1.md:20"
        ],
        "exercise": "counter",
        "reason": null
      },
      {
        "id": "unlock-in-finally",
        "says": "An explicit lock is released in a finally block, so an exception in the critical section cannot leave it held.",
        "basis": [
          "section:Explicit Locking and Unlocking",
          "example:22-locks-semaphores/README_6.3.1.md:5"
        ],
        "exercise": "interruptible",
        "reason": null
      },
      {
        "id": "virtual-threads",
        "says": "A virtual thread blocked on a ReentrantLock unmounts from its carrier, while synchronized can pin it in Java 21.",
        "basis": [
          "section:Relevant Java 21 Features",
          "example:22-locks-semaphores/README_6.3.1.md:22"
        ],
        "exercise": null,
        "reason": "a scheduling property of the runtime that no deterministic test can observe; virtual threads are the subject of module 26"
      }
    ],
