    {
      "id": "practice.RetryTest#makesMaxRetriesPlusOneAttempts",
      "kind": "edge",
      "says": "A task that always fails is tried once plus maxRetries more times, and no more."
    },
    {
      "id": "practice.RetryTest#throwsTheLastAttemptsOwnException",
      "kind": "edge",
      "says": "When every attempt fails, the last attempt's own exception is thrown, not the ExecutionException around it."
    },
    {
      "id": "practice.RetryTest#aHungAttemptIsCancelledAndRetried",
      "kind": "edge",
      "says": "An attempt that does not finish within 5 seconds is cancelled, freeing the executor's thread, and the next attempt runs."
    },
    {
      "id": "practice.RetryTest#anErrorStaysWrapped",
      "kind": "edge",
      "says": "A task that throws an Error, which is not an Exception, ends in the ExecutionException that carries it."
    },
    {
      "id": "practice.RetryTest#aTimedOutLastAttemptIsTheFailure",
      "kind": "edge",
      "says": "When the last attempt times out, its TimeoutException is the failure thrown, not an earlier attempt's exception."
    },
    {
      "id": "practice.RetryTest#eachAttemptGetsTheFullFiveSeconds",
      "kind": "edge",
      "says": "An attempt that takes 1 s succeeds on its own: each attempt gets the full 5 seconds."
