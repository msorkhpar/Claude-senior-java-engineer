  "plan": {
    "plan_api": 2,
    "tier": "core",
    "count": 7,
    "aspects": [
      {
        "id": "backoff",
        "says": "Retries wait longer after each failure, with random jitter, so clients do not retry in lockstep.",
        "basis": [
          "section:Interview Q&A Section"
        ],
        "exercise": null,
        "reason": "a delay between attempts depends on the wall clock, which the practices keep out of their tests; the retry practice keeps the attempts and the thrown cause"
      },
      {
        "id": "callable-vs-runnable",
        "says": "A Callable returns a value and may throw a checked exception, which a Runnable can do neither of.",
        "basis": [
          "section:Callable vs Runnable",
          "tests:23-executors/src/test/java/com/github/msorkhpar/claudejavatutor/executors/CallableFutureDemoTest.java"
        ],
        "exercise": "unwrap",
        "reason": null
      },
      {
        "id": "cancel-cooperative",
        "says": "cancel(true) only interrupts a running task: a task that ignores the interrupt keeps running, though its Future reports it cancelled.",
        "basis": [
          "section:Interview Q&A Section",
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "cancel-on-timeout",
        "says": "A get() that times out leaves the task running, so the caller cancels it with cancel(true) and falls back to a default.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them",
          "section:Interview Q&A Section"
        ],
        "exercise": "fallback",
        "reason": null
      },
      {
        "id": "completable-future",
        "says": "CompletableFuture chains supplyAsync, thenApply and exceptionally without blocking the caller.",
        "basis": [
          "section:Relevant Java 21 Features",
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": "pipeline",
        "reason": null
      },
      {
        "id": "completion-service",
        "says": "A CompletionService hands back Futures in completion order, so a slow early task does not block the results behind it.",
        "basis": [
          "section:CompletionService",
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": "fastest",
        "reason": null
      },
      {
        "id": "execution-exception-cause",
        "says": "A task's exception, checked or not, reaches get() wrapped in ExecutionException, and getCause() gives the original.",
        "basis": [
          "section:Key Points to Remember",
          "section:Interview Q&A Section"
        ],
        "exercise": "unwrap",
        "reason": null
      },
      {
        "id": "get-on-cancelled",
        "says": "get() on a cancelled Future throws CancellationException.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "unwrap",
        "reason": null
      },
      {
        "id": "get-with-timeout",
        "says": "get(timeout, unit) throws TimeoutException instead of blocking forever when the result is late.",
        "basis": [
          "section:Future Interface",
          "section:Common Pitfalls and How to Avoid Them"
        ],
        "exercise": "unwrap",
        "reason": null
      },
      {
        "id": "interrupted-get",
        "says": "A thread interrupted while it waits in get() restores its interrupt flag and cancels the task it abandons.",
        "basis": [
          "section:Edge Cases and Their Handling",
          "section:Interview Q&A Section"
        ],
        "exercise": "fallback",
        "reason": null
      },
      {
        "id": "invoke-all-order",
        "says": "invokeAll() waits for every task and returns their Futures in the order of the input, whatever order they finished in.",
        "basis": [
          "section:Batch Execution",
          "section:Key Points to Remember"
        ],
        "exercise": "gather",
        "reason": null
      },
      {
        "id": "invoke-all-timeout",
        "says": "invokeAll() with a timeout cancels the tasks that have not finished when the time runs out.",
        "basis": [
          "section:Key Points to Remember",
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": "gather",
        "reason": null
      },
      {
        "id": "invoke-any",
        "says": "invokeAny() returns the first successful result, ignores failures while one task can succeed, cancels the rest, and fails only if all fail.",
        "basis": [
          "section:Batch Execution",
          "section:Key Points to Remember"
        ],
        "exercise": "fastest",
        "reason": null
      },
      {
        "id": "invoke-any-empty",
        "says": "invokeAll() of an empty list returns an empty list, while invokeAny() of one throws IllegalArgumentException.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": null,
        "reason": "the executor enforces both by itself, so no practice can get them wrong"
      },
      {
        "id": "null-and-repeat-get",
        "says": "A task may return null, and calling get() again returns the same result or throws the same exception.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": null,
        "reason": "minor facts about Future with nothing further to practise"
      },
      {
        "id": "retry",
        "says": "A retry re-submits the Callable as a new Future for each attempt and, when all fail, throws the last cause.",
        "basis": [
          "section:Interview Q&A Section",
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": "retry",
        "reason": null
      },
      {
        "id": "structured-concurrency",
        "says": "StructuredTaskScope, a Java 21 preview, forks related tasks and joins them with shared cancellation.",
        "basis": [
          "section:Relevant Java 21 Features"
        ],
        "exercise": null,
        "reason": "a preview API that needs --enable-preview, which the practices' Java 21 build does not turn on"
      },
      {
        "id": "virtual-blocking-get",
        "says": "On a virtual thread, blocking in Future.get() is cheap, which lessens the need for non-blocking chains.",
        "basis": [
          "section:Relevant Java 21 Features"
        ],
        "exercise": "quiz",
        "reason": null
      }
    ],
