      },
      {
        "id": "catch-specific",
        "says": "Catching Exception also catches the RuntimeExceptions that signal bugs, so catch only what you can handle.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them"
        ],
        "exercise": "order-lookup",
        "reason": null
      },
      {
        "id": "checked-deliberately",
        "says": "Checked or unchecked is chosen deliberately, by whether a caller can recover.",
