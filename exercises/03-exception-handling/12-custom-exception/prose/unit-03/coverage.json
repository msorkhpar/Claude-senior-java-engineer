        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "atomic-resize",
        "reason": null
      },
      {
        "id": "custom-for-domain",
        "says": "A custom exception is worth creating when the error is part of the domain and callers must tell it apart.",
        "basis": [
          "section:Key Points to Remember",
          "example:12-custom-exception/README_3.2.3.md:3"
        ],
        "exercise": "seat-map",
        "reason": null
      },
      {
        "id": "document-throws",
        "says": "Every exception a public method can throw, checked or unchecked, gets a Javadoc @throws tag.",
        "basis": [
          "section:Key Points to Remember"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "fail-atomically",
        "says": "Validating before changing state leaves the object as it was when a method throws.",
        "basis": [
          "section:Key Points to Remember",
          "tests:12-custom-exception/src/test/java/com/github/msorkhpar/claudejavatutor/exceptions/BankAccountTest.java"
        ],
        "exercise": "bank-account",
        "reason": null
      },
      {
        "id": "immutable-exceptions",
        "says": "Exception objects are immutable: final fields and no setters.",
        "basis": [
          "section:Best Practices"
        ],
        "exercise": null,
        "reason": "3.2.1's file-processing practice checks exactly this; repeating it here would add no new idea"
      },
      {
        "id": "log-once",
        "says": "Logging and rethrowing makes every layer log the same failure; log it once, where it is handled.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them"
        ],
        "exercise": "import-once",
        "reason": null
      },
      {
        "id": "message-values",
        "says": "A message is written for the log's reader: what failed, with which values.",
