        ],
        "exercise": "atomic-resize",
        "reason": null
      },
      {
        "id": "carry-context",
        "says": "A custom exception carries the data a handler needs in typed fields, not only in its message.",
        "basis": [
          "section:Concept Explanation",
          "example:12-custom-exception/README_3.2.3.md:1",
