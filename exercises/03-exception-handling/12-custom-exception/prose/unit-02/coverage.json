        ],
        "exercise": "fail-fast",
        "reason": null
      },
      {
        "id": "rethrow-keeps-trace",
        "says": "Rethrowing the caught exception unchanged keeps its original stack trace.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "log-rethrow",
        "reason": null
      },
      {
        "id": "specific-type",
        "says": "Throw the most specific type, so callers can catch it selectively.",
