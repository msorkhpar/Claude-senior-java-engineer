      {
        "id": "finally-cleanup",
        "says": "Finally is where resources such as readers are closed, however the try block ends.",
        "basis": [
          "section:Key Points",
          "tests:11-try-catch/src/test/java/com/github/msorkhpar/claudejavatutor/trycatch/FinallyBlockDemoTest.java"
        ],
        "exercise": "read-first-line",
        "reason": null
      },
      {
        "id": "finally-for-locks",
        "says": "Cleanup that try-with-resources cannot do, such as releasing a lock, still belongs in finally.",
        "basis": [
          "section:Best Practices",
          "example:11-try-catch/README_3.1.3.md:1"
        ],
        "exercise": "vault",
        "reason": null
      },
      {
        "id": "finally-needs-try",
        "says": "A finally block is optional and can only follow a try block.",
        "basis": [
          "section:Key Points"
        ],
        "exercise": null,
        "reason": "a syntax rule the compiler enforces on every practice here, with no behaviour to observe"
      },
      {
        "id": "finally-regardless",
        "says": "The finally block runs after the try and catch blocks whether or not an exception was thrown or caught.",
        "basis": [
          "section:Key Points",
          "tests:11-try-catch/src/test/java/com/github/msorkhpar/claudejavatutor/trycatch/FinallyBlockDemoTest.java"
        ],
        "exercise": "execution-order",
        "reason": null
      },
      {
        "id": "finally-short",
        "says": "Finally blocks are kept short and focused on cleanup.",
        "basis": [
          "section:Best Practices"
        ],
        "exercise": null,
        "reason": "a style judgement no test can observe; every practice's finally is a single cleanup step"
      },
      {
        "id": "finally-skipped",
        "says": "Finally does not run when the JVM exits first or the try block never finishes, though an interrupted thread still runs it.",
        "basis": [
          "section:Key Points"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "finally-throw-masks",
        "says": "An exception thrown from finally replaces the one from try, so the original is kept by setting it as the new exception's cause.",
        "basis": [
          "section:Edge Cases",
          "example:11-try-catch/README_3.1.3.md:3",
          "example:11-try-catch/README_3.1.3.md:4"
        ],
        "exercise": "keep-the-cause",
        "reason": null
      },
      {
        "id": "no-return-in-finally",
        "says": "A return in finally overrides the try block's outcome, a thrown exception included, so finally never returns.",
        "basis": [
          "section:Common Pitfalls"
        ],
        "exercise": "metered-call",
        "reason": null
      },
      {
        "id": "prefer-twr",
        "says": "For resource management, try-with-resources is preferred over closing in finally.",
