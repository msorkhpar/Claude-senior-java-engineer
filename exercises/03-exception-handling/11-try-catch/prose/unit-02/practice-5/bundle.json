  "provenance": "generated",
  "trust": "advisory",
  "cases": [
    {
      "id": "practice.AlertingTest#aSuccessDoesNotAlert",
      "kind": "main",
      "says": "Work that completes raises no alert."
    },
    {
      "id": "practice.AlertingTest#aFailureIsAlertedAndRethrown",
      "kind": "main",
      "says": "A failure is passed to the alerter and then rethrown as the same exception."
    },
    {
      "id": "practice.AlertingTest#aFailingAlertDoesNotHideTheFailure",
      "kind": "edge",
      "says": "When the alerter throws inside the catch block, the original failure is still the one the caller gets."
    },
    {
      "id": "practice.AlertingTest#theAlertFailureIsKeptAsSuppressed",
      "kind": "edge",
      "says": "The alerter's own failure is not swallowed: it is attached to the original as suppressed."
    },
    {
      "id": "practice.AlertingTest#theRethrownFailureIsTheOriginalObject",
      "kind": "edge",
      "says": "The failure is rethrown as the same object, not a new exception copying its type and message."
    },
    {
      "id": "practice.AlertingTest#anErrorFromTheAlerterIsNotSuppressed",
      "kind": "edge",
      "says": "Only a RuntimeException from the alerter is suppressed; an Error from it reaches the caller."
    }
  ],
  "report": {
    "format": "junit",
