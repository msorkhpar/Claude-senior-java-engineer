  "cases": [
    {
      "id": "practice.FallbackReaderTest#readsFromThePrimary",
      "kind": "main",
      "says": "It reads from the primary and leaves the backup alone when the primary works."
    },
    {
      "id": "practice.FallbackReaderTest#fallsBackWhenThePrimaryFails",
      "kind": "main",
      "says": "When the primary throws an IOException it reads from the backup."
    },
    {
      "id": "practice.FallbackReaderTest#whenBothFailThePrimaryFailureIsNotLost",
      "kind": "edge",
      "says": "When the backup read in the catch block throws too, that failure is thrown with the primary's attached as suppressed."
    },
    {
      "id": "practice.FallbackReaderTest#anUncheckedPrimaryFailureIsNotRetried",
      "kind": "edge",
      "says": "Only an IOException sends the read to the backup; an unchecked failure of the primary reaches the caller."
    },
    {
      "id": "practice.FallbackReaderTest#whenBothFailTheBackupFailureIsThrown",
      "kind": "edge",
      "says": "When both fail, the backup's exception is the one thrown, with the primary's inside it, not the other way round."
    },
    {
      "id": "practice.FallbackReaderTest#aFailingPrimaryIsReadOnce",
      "kind": "edge",
      "says": "A primary that fails is not read a second time: the next read goes to the backup."
    }
  ],
