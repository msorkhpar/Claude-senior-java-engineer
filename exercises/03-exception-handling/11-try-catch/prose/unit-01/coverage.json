    "aspects": [
      {
        "id": "catch-can-throw",
        "says": "Code in a catch block can throw too, and the exception being handled is lost unless it is kept.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": "fallback-reader",
        "reason": null
      },
      {
        "id": "catch-parameter",
        "says": "The catch parameter is the exception itself, so getMessage() gives its detail.",
        "basis": [
          "section:Key Points to Remember",
          "example:11-try-catch/README_3.1.1.md:3"
        ],
        "exercise": "division-report",
        "reason": null
      },
      {
        "id": "catch-specific",
        "says": "Catch the specific exception you expect, because catching Exception masks other failures.",
        "basis": [
          "section:Best Practices and Optimization Techniques",
          "section:Common Pitfalls and How to Avoid Them"
        ],
        "exercise": "lenient-parser",
        "reason": null
      },
      {
        "id": "chain-the-cause",
        "says": "When an exception is wrapped and rethrown, the caught one is passed as the cause so its stack trace survives.",
        "basis": [
          "section:Best Practices and Optimization Techniques",
          "example:11-try-catch/README_3.1.1.md:6",
          "tests:11-try-catch/src/test/java/com/github/msorkhpar/claudejavatutor/trycatch/ExceptionHandlingExampleTest.java"
        ],
        "exercise": "config-loader",
        "reason": null
      },
      {
        "id": "clean-up-resources",
        "says": "Resources are cleaned up even when an exception occurs.",
        "basis": [
          "section:Best Practices and Optimization Techniques"
        ],
        "exercise": null,
        "reason": "the page defers it to 3.1.3 and 3.1.4, whose practices close resources with finally and try-with-resources"
      },
      {
        "id": "jump-to-catch",
        "says": "When a statement in the try block throws, control jumps straight to the matching catch block, and when nothing throws the catch block is skipped.",
        "basis": [
          "section:Key Points to Remember",
          "example:11-try-catch/README_3.1.1.md:1"
        ],
        "exercise": "division-report",
        "reason": null
      },
      {
        "id": "nested-sparingly",
        "says": "Nested try/catch blocks are possible but make code harder to read, so they are used sparingly.",
        "basis": [
          "section:Edge Cases and Their Handling"
        ],
        "exercise": null,
        "reason": "a readability judgement no test can observe; the fallback-reader practice uses the one nested try its task needs"
      },
      {
        "id": "no-empty-catch",
        "says": "A catch block is never left empty: at the least it records what went wrong.",
        "basis": [
          "section:Common Pitfalls and How to Avoid Them"
        ],
        "exercise": "batch-importer",
        "reason": null
      },
      {
        "id": "no-pattern-in-clause",
        "says": "The catch clause itself takes exception types, not patterns.",
        "basis": [
          "section:Relevant Java 21 Features"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "pattern-in-catch",
        "says": "Inside a catch block, instanceof and switch patterns can inspect the caught exception.",
        "basis": [
          "section:Relevant Java 21 Features"
        ],
        "exercise": "exception-classifier",
        "reason": null
      },
      {
        "id": "several-catch-blocks",
        "says": "One try block can be followed by several catch blocks, one per exception type.",
        "basis": [
          "section:Key Points to Remember",
          "example:11-try-catch/README_3.1.1.md:5"
        ],
        "exercise": null,
        "reason": "the page defers it to 3.1.2, whose practices order and combine catch blocks"
      },
      {
        "id": "uncaught-propagates",
        "says": "An exception no catch block matches travels up the call stack, and at the top it ends the program with a stack trace.",
        "basis": [
          "section:Interview Q&A Section",
          "example:11-try-catch/README_3.1.1.md:4"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "why-handle",
        "says": "Exception handling separates error handling from normal code and lets errors travel to the code that can handle them.",
        "basis": [
          "example:11-try-catch/README_3.1.1.md:2"
