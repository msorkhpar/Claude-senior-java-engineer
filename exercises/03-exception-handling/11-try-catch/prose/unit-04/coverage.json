          "example:11-try-catch/README_3.1.4.md:7",
          "tests:11-try-catch/src/test/java/com/github/msorkhpar/claudejavatutor/trycatch/TryWithResourcesDemoTest.java"
        ],
        "exercise": "custom-resource",
        "reason": null
      },
      {
        "id": "effectively-final",
        "says": "A variable named in a try-with-resources header must be final or effectively final.",
        "basis": [
          "section:Java 9+ Enhancements"
        ],
        "exercise": null,
        "reason": "The page states this rule in one sentence and one example, which rule out no plausible alternative, so no fair question can be set; naming an existing resource in try (source) is practised by 'drain'."
      },
      {
        "id": "header-for-resources",
        "says": "The try-with-resources header holds resource declarations only, not unrelated variables or work.",
        "basis": [
          "section:Best Practices"
        ],
        "exercise": null,
        "reason": "a style judgement no test can observe; every practice's header declares resources only"
      },
      {
        "id": "java9-existing-resource",
        "says": "Since Java 9, a resource created before the statement can be named in its header with try (res).",
        "basis": [
          "section:Java 9+ Enhancements",
          "example:11-try-catch/README_3.1.4.md:2"
        ],
        "exercise": "drain",
        "reason": null
      },
      {
        "id": "must-be-autocloseable",
        "says": "Only objects that implement AutoCloseable can be declared as resources.",
        "basis": [
          "section:Common Pitfalls",
          "example:11-try-catch/README_3.1.4.md:5"
        ],
        "exercise": "quiz",
        "reason": null
      },
      {
        "id": "only-opened-closed",
        "says": "Resources are declared in the order they depend on each other, and when a later one fails to open, the ones already opened are still closed.",
        "basis": [
          "section:Best Practices"
        ],
        "exercise": "transfer",
        "reason": null
      },
      {
        "id": "reverse-order",
        "says": "Several resources can share one statement, and they are closed in the reverse order of their declaration.",
        "basis": [
          "section:Key Points",
          "example:11-try-catch/README_3.1.4.md:4"
        ],
        "exercise": "transfer",
        "reason": null
      },
      {
        "id": "suppressed",
        "says": "When the body and a close both throw, the body's exception is thrown and the close exception is attached to it as suppressed.",
        "basis": [
          "section:Common Pitfalls",
          "example:11-try-catch/README_3.1.4.md:6"
        ],
        "exercise": "failure-report",
        "reason": null
      },
      {
        "id": "twr-over-finally",
        "says": "Try-with-resources replaces explicit finally blocks for closing resources, with cleaner code and handled close failures.",
        "basis": [
          "section:Benefits"
