      {
        "id": "auto-close",
        "says": "A resource declared in try-with-resources is closed automatically when the try block exits, normally or by an exception.",
        "basis": [
          "section:Key Points",
          "example:11-try-catch/README_3.1.4.md:3",
          "tests:11-try-catch/src/test/java/com/github/msorkhpar/claudejavatutor/trycatch/TryWithResourcesDemoTest.java"
        ],
        "exercise": "custom-resource",
        "reason": null
      },
      {
        "id": "catch-after-close",
        "says": "A catch or finally block of a try-with-resources statement runs after its resources are closed, and it also sees close failures.",
        "basis": [
          "section:Syntax",
          "example:11-try-catch/README_3.1.4.md:1"
        ],
        "exercise": "trace-order",
        "reason": null
      },
      {
        "id": "closed-after-try",
        "says": "A resource is closed once its try block ends, so using it afterwards fails.",
        "basis": [
          "section:Common Pitfalls",
          "tests:11-try-catch/src/test/java/com/github/msorkhpar/claudejavatutor/trycatch/TryWithResourcesDemoTest.java"
        ],
        "exercise": "custom-resource",
        "reason": null
      },
      {
        "id": "custom-autocloseable",
        "says": "Any class of your own becomes a resource by implementing AutoCloseable and its close() method.",
        "basis": [
