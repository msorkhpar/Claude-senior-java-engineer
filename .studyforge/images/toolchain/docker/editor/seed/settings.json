{
    // Written once by the editor's entrypoint on the first start of a fresh
    // user-data volume. After that this file is yours: edit it in the IDE and
    // the entrypoint will never touch it again.
    //
    // ⭐ Each `@runtime <name>` block is dropped at build time when <name> is
    // not in the image's declared set, so no setting names a runtime the image
    // does not hold. Every member of a block ends in a comma, and the file's
    // last member is outside any block, so the result is valid either way.

    // @runtime java
    // Java: the runner's pinned JDK, at the path the image copies it to. It runs
    // the language server and is the project runtime; its name is filled in
    // from pins.json when the image is built.
    "java.jdt.ls.java.home": "/opt/java/openjdk",
    "java.import.gradle.java.home": "/opt/java/openjdk",
    "java.configuration.runtimes": [
        {
            "name": "@JAVA_RUNTIME@",
            "path": "/opt/java/openjdk",
            "default": true
        }
    ],
    // @end java

    // @runtime python
    // Python: the runner's pinned interpreter, with pytest already installed.
    // Where a corpus keeps its tests is the corpus's to say.
    "python.defaultInterpreterPath": "/usr/local/bin/python3",
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    // @end python

    "workbench.colorTheme": "Default Dark Modern",
    "workbench.startupEditor": "none",
    "telemetry.telemetryLevel": "off",
    "files.autoSave": "afterDelay",

    // The integrated terminal is DECLARED a login shell, so the PATH that
    // /etc/profile.d restores is a stated property, not an inherited default.
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.profiles.linux": {
        "bash": { "path": "bash", "args": ["-l"] }
    }
}
